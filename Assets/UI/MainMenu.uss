/* Main menu: one card in the middle of the screen. Sizes are for the 1920 x 1080 reference resolution. */

#screen {
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 30, 40, 0.25);
}

#card {
    width: 640px;
    padding: 44px 44px 40px 44px;
}

/* Logo, game name and tagline. */
.brand {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
}

.brand-logo {
    width: 74px;
    height: 74px;
    margin-right: 20px;
    align-items: center;
    justify-content: center;
    background-color: var(--green);
    border-radius: 18px;
}

.brand-logo > .icon {
    width: 42px;
    height: 42px;
    -unity-background-image-tint-color: #ffffff;
}

.brand-tagline {
    font-size: 20px;
    color: var(--text-muted);
    margin: 0;
    padding: 0;
}

.view {
    flex-direction: column;
}

.view-title {
    font-size: 30px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0 0 22px 0;
    padding: 0;
}

/* Large choices on the home view: an icon, a title and one line of explanation. */
.menu-button {
    flex-direction: row;
    align-items: center;
    height: 96px;
    padding: 0 24px;
    margin: 0 0 14px 0;
    background-color: var(--control);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: var(--control-border);
    border-radius: 14px;
    transition-duration: 0.12s;
}

.menu-button:hover {
    background-color: var(--control-hover);
}

.menu-button > .icon {
    width: 34px;
    height: 34px;
    margin-right: 20px;
}

.menu-button-texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.menu-button-title {
    -unity-text-align: middle-left;
    font-size: 24px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0;
    padding: 0;
}

.menu-button-text {
    -unity-text-align: middle-left;
    font-size: 17px;
    color: var(--text-muted);
    white-space: normal;
    margin: 2px 0 0 0;
    padding: 0;
}

.menu-button--primary {
    background-color: var(--green);
    border-color: var(--green-dark);
}

.menu-button--primary:hover {
    background-color: var(--green-hover);
}

.menu-button--primary > .icon {
    -unity-background-image-tint-color: #ffffff;
}

.menu-button--primary .menu-button-title,
.menu-button--primary .menu-button-text {
    color: #ffffff;
}

.menu-button:disabled {
    opacity: 0.55;
}

.badge {
    padding: 4px 12px;
    margin: 0;
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text-muted);
    background-color: var(--line);
    border-radius: 12px;
}

.link-button {
    flex-direction: row;
    align-self: center;
    align-items: center;
    margin: 10px 0 0 0;
    padding: 8px 16px;
    font-size: 20px;
    color: var(--text-muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 8px;
}

.link-button:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

.link-button > .icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--text-muted);
}

/* Form fields. */
.field-label {
    font-size: 19px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text-body);
    margin: 0 0 8px 0;
    padding: 0;
}

.field {
    margin: 0;
}

.field > .unity-base-text-field__input,
.field > .unity-text-field__input {
    height: 56px;
    padding: 0 16px;
    font-size: 22px;
    color: var(--text);
    background-color: var(--control);
    border-width: 1px;
    border-color: var(--control-border);
    border-radius: 10px;
}

.field:focus > .unity-base-text-field__input,
.field:focus > .unity-text-field__input {
    border-color: var(--green);
}

.field-hint {
    font-size: 16px;
    color: var(--text-muted);
    white-space: normal;
    margin: 8px 0 22px 0;
    padding: 0;
}

.view-buttons {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

/* A problem with the last game, shown above the current view. */
.error {
    flex-direction: row;
    align-items: center;
    padding: 14px 18px;
    margin-bottom: 22px;
    background-color: #fbe9e5;
    border-width: 1px;
    border-color: #efc2b8;
    border-radius: 10px;
}

.error > .icon {
    width: 24px;
    height: 24px;
    margin-right: 12px;
    -unity-background-image-tint-color: #b8432b;
}

.error-text {
    flex-shrink: 1;
    font-size: 18px;
    color: #8e2f1d;
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* Connecting and loading. */
.progress {
    height: 14px;
    background-color: #e4e1d8;
    border-radius: 7px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--green);
    border-radius: 7px;
}

/* The list of worlds to host: one row per world, the chosen one highlighted. */
.world-list {
    max-height: 330px;
    margin: 0 0 12px 0;
}

.world-row {
    flex-direction: column;
    align-items: stretch;
    padding: 12px 18px;
    margin: 0 0 8px 0;
    background-color: var(--control);
    border-width: 1px;
    border-color: var(--control-border);
    border-radius: 10px;
}

.world-row:hover {
    background-color: var(--control-hover);
}

.world-row--selected,
.world-row--selected:hover {
    background-color: var(--selected);
    border-color: var(--green);
    border-width: 2px;
}

.world-row-name {
    -unity-text-align: middle-left;
    font-size: 22px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0;
    padding: 0;
}

.world-row-details {
    -unity-text-align: middle-left;
    font-size: 16px;
    color: var(--text-muted);
    white-space: normal;
    margin: 2px 0 0 0;
    padding: 0;
}

.world-empty {
    font-size: 18px;
    color: var(--text-muted);
    margin: 0 0 12px 0;
    padding: 0;
}

.world-new {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 50px;
    margin: 0 0 22px 0;
    font-size: 20px;
    color: var(--text-body);
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: var(--control-border);
    border-radius: 10px;
}

.world-new:hover {
    background-color: rgba(0, 0, 0, 0.04);
    border-color: var(--green);
}

.world-new > .icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
}
