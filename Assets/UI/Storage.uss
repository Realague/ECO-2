/* The storage screen: the inventory's look (Inventory.uss), the player's bag on the left and the
   storage on the right. Sizes are for the 1920 x 1080 reference resolution; the
   bottom is left free for the hotbar. */

.storage-half {
    flex-grow: 1;
    flex-basis: 0;
}

.storage-half--right {
    margin-left: 12px;
}

.storage-owner {
    font-size: 19px;
    color: var(--text-muted);
    margin: 0;
    padding: 0;
}

/* What the storage does not take, in the bag. */
.item-slot--dimmed,
.item-slot--dimmed:hover {
    opacity: 0.32;
    border-color: var(--inv-slot-border);
    background-color: var(--inv-slot);
}

/* A stockpile pool's piles: a block of three by three per stockpile, as they stand on the ground,
   one block under another; the list scrolls when the pool holds more than fit. */
.pile-grid {
    flex-grow: 1;
    margin-top: 12px;
}

.pile-grid > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    align-items: center;
}

.pile-block {
    flex-shrink: 0;
    margin-bottom: 18px;
}

.pile-row {
    flex-direction: row;
    flex-shrink: 0;
}

.pile-slot {
    width: 128px;
    height: 128px;
    flex-shrink: 0;
}

.pile-count {
    font-size: 17px;
}

.storage-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.storage-hint {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.storage-hint > .key {
    margin-right: 8px;
}

.storage-hint-text {
    font-size: 16px;
    color: var(--text-muted);
    margin: 0 18px 0 0;
    padding: 0;
}

.storage-pickup {
    height: 44px;
    padding: 0 20px;
}

