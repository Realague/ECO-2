/* The storage screen: the inventory's look (Inventory.uss), the player's bag on the left and the
   storage on the right, each on a card of its own; a campfire's cooking tab reuses the crafting tab's
   layout. Sizes are for the 1920 x 1080 reference resolution; the bottom is left free for the hotbar. */

.storage-half {
    flex-grow: 1;
    flex-basis: 0;
}

/* Two inventories, plainly apart: each its own card, lit along its top in its own colour (the bag
   neutral, the storage copper), with its icon by its title, and a narrow lane between them. */
.storage-card {
    border-top-width: 4px;
}

.storage-card--bag {
    border-top-color: #8d9093;
}

.storage-card--store {
    border-top-color: #c0803f;
}

.storage-card-head {
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-color: var(--panel-border);
}

.storage-card-icon {
    width: 30px;
    height: 30px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--text-muted);
}

/* The storage's own picture (a chest, a stockpile, a campfire), not a tinted glyph. */
.storage-card-icon--item {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

.storage-exchange {
    width: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

/* A dark disc, so that the arrows show over the world seen between the cards. */
.storage-exchange-disc {
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 20px;
}

.storage-exchange-icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--text-muted);
}

.storage-owner {
    font-size: 19px;
    color: var(--text-muted);
    margin: 0 18px 0 0;
    padding: 0;
}

.storage-pickup {
    height: 44px;
    padding: 0 20px;
}

/* What the other side does not take, in the bag. */
.item-slot--dimmed,
.item-slot--dimmed:hover {
    opacity: 0.32;
    border-color: var(--inv-slot-border);
    background-color: var(--inv-slot);
}

/* Merged, or each storage on its own (PoolView). */
.view-toggle {
    flex-direction: row;
    margin-right: 16px;
}

.view-button {
    height: 34px;
    padding: 0 12px;
    margin: 0;
    font-size: 15px;
    color: var(--text-body);
    background-color: var(--well);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 0;
}

.view-button:hover {
    background-color: var(--hover);
}

.view-button--first {
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

.view-button--last {
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left-width: 0;
}

.view-button--selected,
.view-button--selected:hover {
    background-color: #d8c4ab;
    color: var(--tab-selected-text);
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
}

/* Each chest or stockpile on its own card, one under another; the one open framed in copper. */
.member-list {
    flex-grow: 1;
}

.pool-card {
    flex-shrink: 0;
    margin: 0 10px 12px 0;
    padding: 10px 6px 4px 12px;
    background-color: #2b2d2e;
    border-width: 1px;
    border-color: #45484a;
    border-radius: 6px;
}

.pool-card--open {
    border-color: #c0803f;
}

.pool-card-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.pool-card-icon {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.pool-card-title {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0;
    padding: 0;
}

.pool-card-fill {
    margin-right: 8px;
}

.pool-card .pile-block {
    margin-bottom: 8px;
    align-self: center;
}

/* A stockpile's piles: three by three (two by two for a small one), as they stand on the ground. */
.pile-block {
    flex-shrink: 0;
    margin-bottom: 18px;
}

.pile-row {
    flex-direction: row;
    flex-shrink: 0;
}

.pile-slot {
    width: 128px;
    height: 128px;
    flex-shrink: 0;
}

.pile-count {
    font-size: 17px;
}

.storage-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.storage-hint {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.storage-hint > .key {
    margin-right: 8px;
}

.storage-hint-text {
    font-size: 16px;
    color: var(--text-muted);
    margin: 0 18px 0 0;
    padding: 0;
}


/* ---- A campfire (CampfirePage) ---- */

.fire-linked {
    font-size: 17px;
    color: var(--text-muted);
    margin: 0 18px 0 0;
    padding: 0;
}

.fire-linked--none {
    color: var(--danger);
}

.fire-calories {
    margin-left: 18px;
}

/* What is left of the log alight. */
.fire-burn {
    width: 90px;
    height: 10px;
    margin-left: 12px;
    background-color: var(--well);
    border-radius: 5px;
    overflow: hidden;
}

.fire-burn-fill {
    height: 100%;
    width: 0;
    background-color: #e39a3b;
    border-radius: 5px;
}

/* A long dish name gives way to what it takes, cut with an ellipsis. */
.recipe-list .recipe-row-text {
    flex-shrink: 1;
    overflow: hidden;
}

.recipe-list .recipe-row-name {
    overflow: hidden;
    text-overflow: ellipsis;
}

/* A campfire's wood: a narrow card, its slots only as tall as their rows, then how long it burns. */
.storage-card--fuel {
    flex-grow: 0.6;
}

.storage-card--fuel .item-well {
    flex-grow: 0;
    padding-bottom: 12px;
}

.storage-card--fuel .item-grid {
    flex-grow: 0;
    flex-basis: auto;
    height: 162px;
}

/* The hints wrap in the narrow card rather than overlap. */
.storage-card--fuel .storage-hint {
    flex-wrap: wrap;
}

.storage-card--fuel .storage-hint > * {
    flex-shrink: 0;
    margin-bottom: 6px;
}

.fuel-info {
    margin-top: 14px;
    padding: 12px 14px;
    background-color: #2b2d2e;
    border-width: 1px;
    border-color: #45484a;
    border-radius: 6px;
}

.fuel-info-line {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.fuel-info-icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-image-tint-color: #e39a3b;
}

.fuel-info-text {
    flex-shrink: 1;
    font-size: 17px;
    color: var(--text);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.fuel-info-text--muted {
    color: var(--text-muted);
}
