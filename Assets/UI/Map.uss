/* Full-screen map. Sizes are for the 1920 x 1080 reference resolution. */

.map-screen {
    padding: 40px 48px;
    background-color: rgba(20, 30, 40, 0.55);
}

.map-panel {
    flex-grow: 1;
    padding: 22px 26px 20px 26px;
}

.map-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 16px;
}

.map-title {
    font-size: 34px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0;
    padding: 0;
}

.map-heading {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
    margin-right: 24px;
}

/* The climate layer shown, next to the title. */
.map-layer-name {
    font-size: 19px;
    color: var(--text-muted);
    margin: 0 0 5px 18px;
    padding: 0;
}

/* The climate laid over the terrain, which shows through it. */
.map-climate {
    opacity: 0.7;
}

/* One entry per animal species: the line wraps, from the right, when there are many. */
.legend {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
    justify-content: flex-end;
    align-items: center;
}

.legend-item {
    flex-direction: row;
    align-items: center;
    margin: 3px 0 3px 22px;
}

.legend-text {
    font-size: 18px;
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

/* Markers in the legend sit in the line instead of on the map. */
.legend-dot {
    position: relative;
    margin: 0 9px 0 0;
}

.legend-arrow {
    position: relative;
    width: 17px;
    height: 20px;
    margin: 0 9px 0 0;
}

/* The window on the world: dragging and the wheel act on it. */
.map-view {
    flex-grow: 1;
    overflow: hidden;
    background-color: #2b3138;
    border-radius: 14px;
}

.map-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
    min-height: 32px;
}

.map-pointer {
    font-size: 18px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.map-last-key {
    margin-right: 0;
}
