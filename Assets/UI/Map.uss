/* Full-screen map. Sizes are for the 1920 x 1080 reference resolution. */

.map-screen {
    padding: 40px 48px;
    background-color: rgba(20, 30, 40, 0.55);
}

.map-panel {
    flex-grow: 1;
    padding: 22px 26px 20px 26px;
}

.map-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 16px;
}

.map-title {
    font-size: 34px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0;
    padding: 0;
}

.map-heading {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
    margin-right: 24px;
}

/* The climate layer shown, next to the title. */
.map-layer-name {
    font-size: 19px;
    color: var(--text-muted);
    margin: 0 0 16px 18px;
    padding: 0;
}

/* The climate laid over the terrain, which shows through it. */
.map-climate {
    opacity: 0.7;
}

/* The legend: you and the other players (each species has its colour in the species list). It wraps from the right. */
.legend {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
    justify-content: flex-end;
    align-items: center;
}

.legend-item {
    flex-direction: row;
    align-items: center;
    margin: 3px 0 3px 22px;
}

.legend-text {
    font-size: 18px;
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

/* Markers in the legend sit in the line instead of on the map. */
.legend-dot {
    position: relative;
    margin: 0 9px 0 0;
}

.legend-arrow {
    position: relative;
    width: 17px;
    height: 20px;
    margin: 0 9px 0 0;
}

/* The window on the world: dragging and the wheel act on it. */
.map-view {
    flex-grow: 1;
    overflow: hidden;
    background-color: #1c1e1f;
    border-radius: 14px;
}

.map-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    margin-top: 16px;
    min-height: 32px;
}

.map-pointer {
    font-size: 18px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.map-last-key {
    margin-right: 0;
}

/* The map and the species list side by side. */
.map-body {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
}

/* Where the chosen species lives: drawn over the terrain and the climate, which show through its empty cells. */
.map-species {
    -unity-background-scale-mode: stretch-to-fill;
}

.species-panel {
    width: 330px;
    flex-shrink: 0;
    margin-left: 18px;
}

.species-title {
    font-size: 24px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0 0 10px 0;
    padding: 0;
}

.species-search {
    margin: 0;
}

.species-search > .unity-base-text-field__input,
.species-search > .unity-text-field__input {
    height: 44px;
    padding: 0 14px;
    font-size: 19px;
    color: var(--text);
    background-color: var(--well);
    border-width: 1px;
    border-color: var(--control-border);
    border-radius: 10px;
    --unity-cursor-color: var(--text);
}

.species-search:focus > .unity-base-text-field__input,
.species-search:focus > .unity-text-field__input {
    border-color: var(--accent);
}

.species-hint {
    font-size: 15px;
    color: var(--text-muted);
    white-space: normal;
    margin: 6px 0 10px 0;
    padding: 0;
}

/* Its height comes from the panel, not from its rows, so a long list scrolls instead of pushing the header up. */
.species-list {
    flex-grow: 1;
    flex-basis: 0;
}

/* The drop-down menus "Plants" and "Animals" (Foldout), their species inside. */
.species-group {
    margin: 4px 0 2px 0;
}

.species-group > .unity-foldout__toggle {
    margin: 0;
    padding: 6px 6px;
    border-radius: 8px;
}

.species-group > .unity-foldout__toggle:hover {
    background-color: var(--hover);
}

.species-group .unity-foldout__text {
    font-size: 18px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
}

.species-group > .unity-foldout__content {
    margin: 2px 0 6px 6px;
}

.species-row {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 10px;
    margin: 0 0 2px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 8px;
}

.species-row:hover {
    background-color: var(--hover);
}

.species-row--selected,
.species-row--selected:hover {
    background-color: var(--selected);
    border-color: var(--accent);
}

.species-swatch {
    width: 14px;
    height: 14px;
    margin-right: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    border-radius: 7px;
}

.species-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 17px;
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.species-count {
    -unity-text-align: middle-right;
    font-size: 16px;
    color: var(--text-muted);
    margin: 0;
    padding: 0;
}
