<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Common.uss" />
    <Style src="MainMenu.uss" />

    <!-- MainMenu shows one view at a time: home, host, join, or busy (connecting or loading). -->
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="card" class="panel">
            <ui:VisualElement class="brand">
                <ui:VisualElement class="brand-logo">
                    <ui:VisualElement class="icon icon--plant" />
                </ui:VisualElement>
                <ui:VisualElement>
                    <ui:Label name="game-title" text="ECO 2" class="title" />
                    <ui:Label text="A living world, shared with friends." class="brand-tagline" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="error" class="error hidden">
                <ui:VisualElement class="icon icon--warning" />
                <ui:Label name="error-text" class="error-text" />
            </ui:VisualElement>

            <!-- Home: what to do. -->
            <ui:VisualElement name="view-home" class="view">
                <ui:Button name="host-button" class="menu-button menu-button--primary">
                    <ui:VisualElement class="icon icon--house" />
                    <ui:VisualElement class="menu-button-texts">
                        <ui:Label text="Host a game" class="menu-button-title" />
                        <ui:Label text="Play in your world; friends can join you." class="menu-button-text" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="join-button" class="menu-button">
                    <ui:VisualElement class="icon icon--globe" />
                    <ui:VisualElement class="menu-button-texts">
                        <ui:Label text="Join a game" class="menu-button-title" />
                        <ui:Label text="Enter the address of a friend's game or a server." class="menu-button-text" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="options-button" class="menu-button">
                    <ui:VisualElement class="icon icon--gear" />
                    <ui:VisualElement class="menu-button-texts">
                        <ui:Label text="Options" class="menu-button-title" />
                        <ui:Label text="Graphics, controls and sound." class="menu-button-text" />
                    </ui:VisualElement>
                    <ui:Label text="Soon" class="badge" />
                </ui:Button>
                <ui:Button name="quit-button" class="link-button">
                    <ui:VisualElement class="icon icon--sign-out" />
                    <ui:Label text="Quit" class="button-text" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Host: an optional password. -->
            <ui:VisualElement name="view-host" class="view hidden">
                <ui:Label text="Host a game" class="view-title" />
                <ui:Label text="Password" class="field-label" />
                <ui:TextField name="host-password" password="true" max-length="64" class="field" />
                <ui:Label name="host-hint" class="field-hint" />
                <ui:VisualElement class="view-buttons">
                    <ui:Button name="host-back" class="button button--secondary">
                        <ui:VisualElement class="icon icon--arrow-left" />
                        <ui:Label text="Back" class="button-text" />
                    </ui:Button>
                    <ui:Button name="host-start" class="button button--primary">
                        <ui:VisualElement class="icon icon--play" />
                        <ui:Label text="Start" class="button-text" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Join: where, and the password if the game has one. -->
            <ui:VisualElement name="view-join" class="view hidden">
                <ui:Label text="Join a game" class="view-title" />
                <ui:Label text="Address" class="field-label" />
                <ui:TextField name="join-address" max-length="15" class="field" />
                <ui:Label text="The IPv4 address of the host, for example 192.168.1.20." class="field-hint" />
                <ui:Label text="Password" class="field-label" />
                <ui:TextField name="join-password" password="true" max-length="64" class="field" />
                <ui:Label text="Leave it empty if the game has none." class="field-hint" />
                <ui:VisualElement class="view-buttons">
                    <ui:Button name="join-back" class="button button--secondary">
                        <ui:VisualElement class="icon icon--arrow-left" />
                        <ui:Label text="Back" class="button-text" />
                    </ui:Button>
                    <ui:Button name="join-start" class="button button--primary">
                        <ui:VisualElement class="icon icon--play" />
                        <ui:Label text="Join" class="button-text" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Busy: connecting to a server, then loading its world. -->
            <ui:VisualElement name="view-busy" class="view hidden">
                <ui:Label name="busy-title" class="view-title" />
                <ui:VisualElement class="progress">
                    <ui:VisualElement name="busy-progress" class="progress-fill" />
                </ui:VisualElement>
                <ui:Label name="busy-text" class="field-hint" />
                <ui:VisualElement class="view-buttons">
                    <ui:Button name="busy-cancel" class="button button--secondary">
                        <ui:Label text="Cancel" class="button-text" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
