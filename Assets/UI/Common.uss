/* Shared look of the game's screens, in the colours of the user's mockup: charcoal panels with
   near-white text, tan for the chosen tab and category, a pale gold frame around what is selected,
   slate green actions and cream sheets. */

:root {
    --panel: #27292b;
    --panel-border: rgba(255, 255, 255, 0.08);
    --veil: rgba(30, 31, 30, 0.9);
    --well: rgba(16, 17, 18, 0.55);
    --text: #f6f5f2;
    --text-body: #e4e2dd;
    --text-muted: #aaa8a3;
    --line: rgba(255, 255, 255, 0.12);
    --control: #46484a;
    --control-border: #1d1f20;
    --control-hover: #535557;
    --hover: rgba(255, 255, 255, 0.06);
    --selected: #a4917a;
    --accent: #f3dfae;
    --danger: #ee927a;
    --danger-action: #a3443a;
    --danger-action-hover: #b8544a;
    --danger-action-dark: #6b2a24;
    --carbs: #d9664a;
    --protein: #e3963f;
    --fat: #e8cc5a;
    --vitamins: #84b65a;
    --action: #35504e;
    --action-hover: #41615e;
    --action-dark: #233837;
    --tab-selected: #dcc8ae;
    --tab-selected-text: #1e1711;
}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-font-definition: url("Fonts/Inter-Regular.ttf");
    color: var(--text-body);
}

.strong {
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
}

.panel {
    padding: 40px 36px 34px 36px;
    background-color: var(--panel);
    border-radius: 24px;
    border-width: 1px;
    border-color: var(--panel-border);
}

.title {
    font-size: 46px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0 0 6px 0;
    padding: 0;
}

/* A square image tinted by the text colour of its context; the image comes from a modifier class. */
.icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-body);
}

.icon--lock { background-image: url("Icons/Lock.png"); }
.icon--caret-left { background-image: url("Icons/CaretLeft.png"); }
.icon--caret-right { background-image: url("Icons/CaretRight.png"); }
.icon--check { background-image: url("Icons/Check.png"); }
.icon--rotate { background-image: url("Icons/ArrowsClockwise.png"); }
.icon--up-down { background-image: url("Icons/ArrowsDownUp.png"); }
.icon--left-right { background-image: url("Icons/ArrowsLeftRight.png"); }
.icon--arrow-left { background-image: url("Icons/ArrowLeft.png"); }
.icon--gear { background-image: url("Icons/GearSix.png"); }
.icon--globe { background-image: url("Icons/Globe.png"); }
.icon--house { background-image: url("Icons/HouseSimple.png"); }
.icon--plant { background-image: url("Icons/Plant.png"); }
.icon--play { background-image: url("Icons/Play.png"); }
.icon--plus { background-image: url("Icons/Plus.png"); }
.icon--sign-out { background-image: url("Icons/SignOut.png"); }
.icon--warning { background-image: url("Icons/WarningCircle.png"); }
.icon--backpack { background-image: url("Icons/Backpack.png"); }
/* The inventory's tab and categories: solid glyphs cut from the user's mockup (the seeds' drawn by Eco > Write category icons). */
.icon--category-all { background-image: url("Icons/CategoryAll.png"); }
.icon--category-tools { background-image: url("Icons/CategoryTools.png"); }
.icon--category-blocks { background-image: url("Icons/CategoryBlocks.png"); }
.icon--category-seeds { background-image: url("Icons/CategorySeeds.png"); }
.icon--category-food { background-image: url("Icons/CategoryFood.png"); }
.icon--category-materials { background-image: url("Icons/CategoryMaterials.png"); }
.icon--tab-inventory { background-image: url("Icons/TabInventory.png"); }
.icon--fire { background-image: url("Icons/Fire.png"); }
.icon--scales { background-image: url("Icons/Scales.png"); }
.icon--search { background-image: url("Icons/MagnifyingGlass.png"); }

.button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 64px;
    padding: 0 30px;
    margin: 0;
    font-size: 22px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    border-radius: 10px;
    border-width: 0;
    transition-duration: 0.12s;
}

.button > .icon {
    margin-right: 10px;
}

.button--primary {
    background-color: var(--action);
    border-bottom-width: 4px;
    border-color: var(--action-dark);
    color: var(--text);
}

.button--primary:hover {
    background-color: var(--action-hover);
}

.button--primary > .icon {
    -unity-background-image-tint-color: var(--text);
}

.button--secondary {
    background-color: var(--control);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: var(--control-border);
    color: var(--text-body);
}

.button--secondary:hover {
    background-color: var(--control-hover);
}

/* A button that takes something away (Remove), in red. */
.button--danger {
    background-color: var(--danger-action);
    border-bottom-width: 4px;
    border-color: var(--danger-action-dark);
    color: var(--text);
}

.button--danger:hover {
    background-color: var(--danger-action-hover);
}

/* Text inside a button; it takes the button's colour, which text inherits. */
.button-text {
    margin: 0;
    padding: 0;
}

/* Keyboard hints, each key drawn as a keycap. */
.keys {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.key {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 32px;
    min-width: 46px;
    padding: 0 9px;
    margin-right: 8px;
    background-color: var(--control);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: var(--control-border);
    border-radius: 6px;
}

.key > .icon {
    width: 18px;
    height: 18px;
}

.key-text {
    font-size: 16px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.key-label {
    font-size: 18px;
    color: var(--text-muted);
    margin: 0 18px 0 0;
    padding: 0;
}

.dialog-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
}

.dialog {
    width: 600px;
    padding: 34px;
    background-color: var(--panel);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--panel-border);
}

.dialog-text {
    font-size: 22px;
    color: var(--text);
    white-space: normal;
    margin: 0 0 28px 0;
    padding: 0;
}

.dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.dialog-buttons > .button {
    margin-left: 14px;
}

/* Tabs: the screens a panel opens on (the inventory and the map). */
.tabs {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 14px;
    padding: 5px;
}

.tab {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 24px;
    margin: 0 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 10px;
}

.tab:hover {
    background-color: var(--hover);
}

.tab--selected,
.tab--selected:hover {
    background-color: var(--tab-selected);
}

.tab > .icon {
    margin-right: 10px;
    -unity-background-image-tint-color: var(--text-muted);
}

.tab--selected > .icon {
    -unity-background-image-tint-color: var(--tab-selected-text);
}

.tab-text {
    font-size: 22px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text-muted);
    margin: 0;
    padding: 0;
}

.tab--selected > .tab-text {
    color: var(--tab-selected-text);
}

/* Scroll bars: a thin light thumb on a faint track, without the end buttons of Unity's default theme. */
.screen .unity-scroller--vertical {
    width: 10px;
    margin-left: 4px;
}

.screen .unity-scroller__low-button,
.screen .unity-scroller__high-button {
    display: none;
}

.screen .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
}

.screen .unity-scroller .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 5px;
}

.screen .unity-scroller .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.22);
    border-width: 0;
    border-radius: 5px;
}

.screen .unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.34);
}

/* The arrow of drop-down menus (Foldout). */
.screen .unity-foldout__checkmark {
    -unity-background-image-tint-color: var(--text-muted);
}

/* A nutrient's colour, as in the stomach pie (the hotbar's stomach, the inventory's food details). */
.stomach-dot {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    margin-right: 7px;
    border-radius: 5px;
}

.stomach-dot--carbs { background-color: var(--carbs); }
.stomach-dot--protein { background-color: var(--protein); }
.stomach-dot--fat { background-color: var(--fat); }
.stomach-dot--vitamins { background-color: var(--vitamins); }

/* A carrying gauge (40 blocks, 30 kg of the rest), in the inventory and beside the hotbar: a
   label over a thin bar, gold when nearly full and red when full (CarryHud.ShowGauge). */
.carry-text {
    font-size: 15px;
    color: var(--text-muted);
    white-space: nowrap;
    margin: 0 0 4px 0;
    padding: 0;
}

.carry-bar {
    height: 6px;
    background-color: var(--well);
    border-radius: 3px;
    overflow: hidden;
}

.carry-fill {
    height: 100%;
    width: 0;
    background-color: var(--action-hover);
    border-radius: 3px;
}

.carry-fill--high {
    background-color: var(--accent);
}

.carry-fill--full {
    background-color: var(--danger);
}

.hidden {
    display: none;
}
