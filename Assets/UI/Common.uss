/* Shared look of the game's screens: a light theme with cream panels, dark text and green actions. */

:root {
    --panel: #f6f4ef;
    --panel-border: rgba(0, 0, 0, 0.06);
    --text: #1f2124;
    --text-body: #2a2c30;
    --text-muted: #5d6067;
    --line: #dcd8ce;
    --control: #ffffff;
    --control-border: #d6d2c8;
    --control-hover: #f2f0ea;
    --selected: #e3eedb;
    --green: #4f9a3e;
    --green-hover: #5aab48;
    --green-dark: #3d7d2f;
}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-font-definition: url("Fonts/Inter-Regular.ttf");
    color: var(--text-body);
}

.strong {
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
}

.panel {
    padding: 40px 36px 34px 36px;
    background-color: var(--panel);
    border-radius: 24px;
    border-width: 1px;
    border-color: var(--panel-border);
}

.title {
    font-size: 46px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0 0 6px 0;
    padding: 0;
}

/* A square image tinted by the text colour of its context; the image comes from a modifier class. */
.icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-body);
}

.icon--lock { background-image: url("Icons/Lock.png"); }
.icon--caret-left { background-image: url("Icons/CaretLeft.png"); }
.icon--caret-right { background-image: url("Icons/CaretRight.png"); }
.icon--check { background-image: url("Icons/Check.png"); }
.icon--rotate { background-image: url("Icons/ArrowsClockwise.png"); }
.icon--up-down { background-image: url("Icons/ArrowsDownUp.png"); }
.icon--left-right { background-image: url("Icons/ArrowsLeftRight.png"); }
.icon--arrow-left { background-image: url("Icons/ArrowLeft.png"); }
.icon--gear { background-image: url("Icons/GearSix.png"); }
.icon--globe { background-image: url("Icons/Globe.png"); }
.icon--house { background-image: url("Icons/HouseSimple.png"); }
.icon--plant { background-image: url("Icons/Plant.png"); }
.icon--play { background-image: url("Icons/Play.png"); }
.icon--sign-out { background-image: url("Icons/SignOut.png"); }
.icon--warning { background-image: url("Icons/WarningCircle.png"); }

.button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 64px;
    padding: 0 30px;
    margin: 0;
    font-size: 22px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    border-radius: 10px;
    border-width: 0;
    transition-duration: 0.12s;
}

.button > .icon {
    margin-right: 10px;
}

.button--primary {
    background-color: var(--green);
    border-bottom-width: 4px;
    border-color: var(--green-dark);
    color: #ffffff;
}

.button--primary:hover {
    background-color: var(--green-hover);
}

.button--primary > .icon {
    -unity-background-image-tint-color: #ffffff;
}

.button--secondary {
    background-color: var(--control);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: var(--control-border);
    color: var(--text-body);
}

.button--secondary:hover {
    background-color: var(--control-hover);
}

/* Text inside a button; it takes the button's colour, which text inherits. */
.button-text {
    margin: 0;
    padding: 0;
}

/* Keyboard hints, each key drawn as a keycap. */
.keys {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.key {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 32px;
    min-width: 46px;
    padding: 0 9px;
    margin-right: 8px;
    background-color: var(--control);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: #cfcbc0;
    border-radius: 6px;
}

.key > .icon {
    width: 18px;
    height: 18px;
}

.key-text {
    font-size: 16px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.key-label {
    font-size: 18px;
    color: var(--text-muted);
    margin: 0 18px 0 0;
    padding: 0;
}

.dialog-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
}

.dialog {
    width: 600px;
    padding: 34px;
    background-color: var(--panel);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--panel-border);
}

.dialog-text {
    font-size: 22px;
    color: var(--text);
    white-space: normal;
    margin: 0 0 28px 0;
    padding: 0;
}

.dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.dialog-buttons > .button {
    margin-left: 14px;
}

.hidden {
    display: none;
}
