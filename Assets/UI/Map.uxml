<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:vc="Voxel.Client">
    <Style src="Common.uss" />
    <Style src="MapMarkers.uss" />
    <Style src="Map.uss" />

    <!-- MapScreen places the picture, the climate and species layers, the dots and the arrow, and
         fills in the layers' names and what lies under the pointer; SpeciesPanel fills the species list. -->
    <ui:VisualElement name="screen" class="screen map-screen">
        <ui:VisualElement class="panel map-panel">
            <ui:VisualElement class="map-header">
                <ui:VisualElement class="map-heading">
                    <ui:Label text="Map" class="map-title" />
                    <ui:Label name="layer-name" class="map-layer-name" />
                </ui:VisualElement>
                <ui:VisualElement name="legend" class="legend">
                    <ui:VisualElement class="legend-item">
                        <vc:MapArrow class="map-arrow legend-arrow" />
                        <ui:Label text="You" class="legend-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="legend-item">
                        <ui:VisualElement class="map-player legend-dot" />
                        <ui:Label text="Players" class="legend-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="map-body">
                <ui:VisualElement name="map-view" class="map-view">
                    <ui:VisualElement name="map-image" class="map-image" picking-mode="Ignore" />
                    <ui:VisualElement name="map-climate" class="map-image map-climate" picking-mode="Ignore" />
                    <ui:VisualElement name="map-species" class="map-image map-species" picking-mode="Ignore" />
                    <ui:VisualElement name="map-players" class="map-layer" picking-mode="Ignore" />
                    <vc:MapArrow name="map-arrow" class="map-arrow" />
                </ui:VisualElement>

                <!-- SpeciesPanel fills the list: every plant and animal species, with its colour and how many there are. -->
                <ui:VisualElement name="species-panel" class="species-panel">
                    <ui:Label text="Species" class="species-title" />
                    <ui:TextField name="species-search" max-length="32" class="field species-search" />
                    <ui:Label text="Click one to see where it lives." class="species-hint" />
                    <ui:ScrollView name="species-list" class="species-list" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="map-footer">
                <ui:Label name="pointer-position" class="map-pointer" />
                <ui:VisualElement class="keys">
                    <ui:VisualElement class="key"><ui:Label text="Wheel" class="key-text" /></ui:VisualElement>
                    <ui:Label text="zoom" class="key-label" />
                    <ui:VisualElement class="key"><ui:Label text="Drag" class="key-text" /></ui:VisualElement>
                    <ui:Label text="move" class="key-label" />
                    <ui:VisualElement class="key"><ui:Label text="Space" class="key-text" /></ui:VisualElement>
                    <ui:Label text="centre on you" class="key-label" />
                    <ui:VisualElement class="key"><ui:Label text="Tab" class="key-text" /></ui:VisualElement>
                    <ui:Label text="climate" class="key-label" />
                    <ui:VisualElement class="key"><ui:Label text="Right click" class="key-text" /></ui:VisualElement>
                    <ui:Label text="teleport here" class="key-label" />
                    <ui:VisualElement class="key"><ui:Label text="M" class="key-text" /></ui:VisualElement>
                    <ui:Label text="close" class="key-label map-last-key" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
