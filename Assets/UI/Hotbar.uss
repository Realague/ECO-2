/* The ten quick slots at the bottom of the screen, dark with a gold frame on the held one like the
   inventory. Sizes are for the 1920 x 1080 reference resolution. */

.hotbar-screen {
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 22px;
}

/* The held item's name, shown a moment above the bar when it changes. */
.hotbar-held {
    font-size: 21px;
    color: var(--text);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    margin: 0 0 10px 0;
    padding: 0;
    min-height: 28px;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.hotbar {
    flex-direction: row;
    padding: 8px;
    background-color: var(--veil);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--panel-border);
}

.hotbar-slot {
    width: 76px;
    height: 76px;
    margin: 0 4px;
    background-color: rgba(33, 34, 34, 0.9);
    border-radius: 9px;
    border-width: 2px;
    border-color: #4a4c4d;
    align-items: center;
    justify-content: center;
    transition-property: border-color, scale;
    transition-duration: 0.1s;
}

.hotbar-slot--selected {
    border-width: 3px;
    border-color: var(--accent);
    background-color: rgba(52, 54, 52, 0.95);
    scale: 1.06 1.06;
}

.hotbar-slot--empty {
    background-color: rgba(30, 31, 31, 0.7);
}

/* An item the player ran out of keeps its slot, greyed. */
.hotbar-slot--spent > .hotbar-icon {
    opacity: 0.3;
}

.hotbar-icon {
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

.hotbar-number {
    position: absolute;
    left: 6px;
    top: 3px;
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
    padding: 0;
}

.hotbar-slot--selected > .hotbar-number {
    color: var(--accent);
}

.hotbar-count {
    position: absolute;
    right: 6px;
    bottom: 3px;
    font-size: 16px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.7);
    margin: 0;
    padding: 0;
}

/* The stomach, hanging at the bar's left (outside it, so the bar stays centred): its pie, the
   calories under it and each nutrient's share beside it. Its size is fixed, so it never moves as
   the calories or the shares change. */
.stomach {
    position: absolute;
    right: 100%;
    top: -1px;
    bottom: -1px;
    width: 252px;
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
    padding: 6px 14px 6px 10px;
    background-color: var(--veil);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--panel-border);
}

/* As wide as "3,000 kcal", whatever the calories. */
.stomach-gauge {
    width: 80px;
    flex-shrink: 0;
    align-items: center;
    margin-right: 10px;
}

.stomach-pie {
    width: 60px;
    height: 60px;
    --carbs-colour: var(--carbs);
    --protein-colour: var(--protein);
    --fat-colour: var(--fat);
    --vitamins-colour: var(--vitamins);
    --pie-back: rgba(0, 0, 0, 0.35);
    --pie-rim: rgba(243, 223, 174, 0.55);
}

.stomach-kcal {
    width: 100%;
    font-size: 14px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin: 2px 0 0 0;
    padding: 0;
}

.stomach-kcal--low {
    color: var(--danger);
}

.stomach-legend {
    width: 132px;
    flex-shrink: 0;
    overflow: hidden;
}

.stomach-row {
    flex-direction: row;
    align-items: center;
    height: 18px;
}

.stomach-nutrient {
    font-size: 14px;
    color: var(--text-body);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

/* An empty stomach has no balance to show: a warning takes the legend's place. */
.stomach-starving {
    display: none;
    width: 132px;
    flex-shrink: 0;
    font-size: 15px;
    color: var(--danger);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.stomach--starving > .stomach-legend {
    display: none;
}

.stomach--starving > .stomach-starving {
    display: flex;
}

/* What the player carries, hanging at the bar's right like the stomach at its left. */
.hotbar-carry {
    position: absolute;
    left: 100%;
    top: -1px;
    bottom: -1px;
    width: 190px;
    justify-content: center;
    margin-left: 12px;
    padding: 8px 14px;
    background-color: var(--veil);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--panel-border);
}

.hotbar-carry .carry-text {
    font-size: 14px;
    color: var(--text-body);
}

.hotbar-carry-second {
    margin-top: 10px;
}

/* The hammer's panel, above the bar: the block to place, its shape and the mode, and the keys. */
.build-panel {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 8px 14px 8px 10px;
    background-color: var(--veil);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--panel-border);
}

.build-icon {
    width: 52px;
    height: 52px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.build-text {
    width: 300px;
    margin-right: 14px;
}

.build-block {
    font-size: 19px;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    padding: 0;
}

.build-detail {
    font-size: 15px;
    color: var(--accent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 2px 0 0 0;
    padding: 0;
}

.build-keys .key-label {
    font-size: 16px;
    margin-right: 12px;
}

/* The hammer's wheel, while R is held: shapes on the inner ring, the bag's construction blocks on
   the outer one, around the middle of the screen. BuildingHud places the slots and sizes the discs. */
.build-wheel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.wheel-anchor {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.wheel-disc {
    position: absolute;
    background-color: var(--veil);
    border-width: 1px;
    border-color: var(--panel-border);
}

.wheel-disc--outer {
    background-color: rgba(30, 31, 30, 0.62);
}

.wheel-slot {
    position: absolute;
    translate: -50% -50%;
    align-items: center;
    justify-content: center;
    background-color: rgba(33, 34, 34, 0.92);
    border-width: 2px;
    border-color: #4a4c4d;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.08s;
}

.wheel-slot--shape {
    width: 78px;
    height: 78px;
    border-radius: 14px;
}

.wheel-slot--block {
    width: 64px;
    height: 64px;
    border-radius: 10px;
}

.wheel-slot--chosen {
    border-width: 3px;
    border-color: var(--accent);
}

.wheel-slot--hover {
    scale: 1.14 1.14;
    background-color: rgba(64, 66, 62, 0.97);
    border-color: #ffffff;
}

/* A door has no shape: the shapes stay, faded. */
.wheel-slot--faded > .shape-glyph {
    opacity: 0.35;
}

.shape-glyph {
    width: 60px;
    height: 60px;
    --shape-top: #dcb378;
    --shape-left: #9e784a;
    --shape-right: #bd915c;
    --shape-line: #2b1f14;
}

.wheel-block-icon {
    width: 46px;
    height: 46px;
    -unity-background-scale-mode: scale-to-fit;
}

.wheel-block-count {
    position: absolute;
    right: 4px;
    bottom: 1px;
    font-size: 13px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.7);
    margin: 0;
    padding: 0;
}

.wheel-centre {
    position: absolute;
    width: 200px;
    translate: -50% -50%;
    align-items: center;
}

.wheel-name {
    font-size: 19px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.wheel-hint {
    font-size: 13px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 6px 0 0 0;
    padding: 0;
}

.wheel-pointer {
    position: absolute;
    width: 12px;
    height: 12px;
    translate: -50% -50%;
    border-radius: 6px;
    background-color: var(--accent);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}
