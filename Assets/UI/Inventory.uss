/* The inventory screen, after the user's mockup: tabs along the top of a charcoal panel holding the
   categories (a darker column, the chosen one tan) and a well of dark item slots, five or so across
   (InventoryScreen sizes them to fill it), and beside it a dark frame holding the chosen item's cream
   sheet. Sizes are for the 1920 x 1080 reference resolution; the bottom is left free for the hotbar,
   which takes dragged items. */

.inventory-screen {
    --inv-strip: #25292e;
    --inv-column: #252626;
    --inv-main: #2a2c2c;
    --inv-slot: #242625;
    --inv-slot-border: #47494a;
    --inv-slot-hover: #2f3131;
    --inv-slot-selected: #2b2d2c;
    --inv-category-selected: #a4917a;
    --inv-sheet: #ddd0bb;
    --inv-sheet-line: #c9baa6;
    --inv-sheet-text: #1e1711;
    --inv-sheet-muted: #54493e;
    --inv-sheet-well: #c9b9a5;
    padding: 118px 150px 146px 150px;
    background-color: rgba(10, 10, 10, 0.35);
}

.inventory-frame {
    flex-grow: 1;
    flex-direction: row;
}

.inventory-left {
    flex-grow: 1;
}

/* The tab bar, as in the mockup: a bar of its own over about four fifths of the width, above both
   panels, charcoal with a light line along its top and a lighter one along its bottom; the chosen tab
   a tan block set in it, outlined dark and lit along its top, its text dark and bold. */
.inventory-tabs {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    width: 80%;
    height: 68px;
    margin-bottom: 6px;
    padding: 3px 18px 3px 3px;
    background-color: var(--inv-strip);
    border-width: 1px;
    border-top-color: #3b4148;
    border-left-color: #33373c;
    border-right-color: #33373c;
    border-bottom-color: #4a4b4e;
    border-radius: 6px;
}

.inventory-tab {
    flex-direction: row;
    align-items: center;
    height: 100%;
    padding: 0 36px 0 30px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-right-width: 1px;
    border-right-color: #505154;
    border-radius: 0;
}

.inventory-tab:hover {
    background-color: var(--hover);
}

.inventory-tab--selected,
.inventory-tab--selected:hover {
    background-color: #d8c4ab;
    border-width: 1px;
    border-color: #0c0c0d;
    border-top-color: #e5d8c5;
    border-radius: 4px;
}

.inventory-tab-icon {
    width: 28px;
    height: 28px;
    margin-right: 14px;
    -unity-background-image-tint-color: var(--text);
}

.inventory-tab--selected > .inventory-tab-icon {
    -unity-background-image-tint-color: var(--tab-selected-text);
}

.inventory-tab-text {
    font-size: 22px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.inventory-tab--selected > .inventory-tab-text {
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--tab-selected-text);
}

.inventory-tabs-space {
    flex-grow: 1;
}

/* The player's speciality, or the button to choose one. */
.speciality {
    flex-direction: row;
    align-items: center;
}

.speciality > .icon {
    margin-right: 8px;
    -unity-background-image-tint-color: var(--accent);
}

.speciality-name {
    font-size: 18px;
    color: var(--text-muted);
    margin: 0 14px 0 0;
    padding: 0;
}

.speciality-choose {
    height: 42px;
    padding: 0 18px;
    font-size: 17px;
}

.inventory-main {
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--inv-main);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
    overflow: hidden;
}

.column-title {
    font-size: 22px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0 0 16px 0;
    padding: 0;
}

/* Categories down the left, on a darker column. */
.categories {
    width: 270px;
    flex-shrink: 0;
    padding: 22px 12px 12px 12px;
    background-color: var(--inv-column);
    border-right-width: 1px;
    border-color: var(--panel-border);
}

.categories > .column-title {
    margin-left: 10px;
}

.category {
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding: 0 16px;
    margin: 0 0 6px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
}

.category:hover {
    background-color: var(--hover);
}

.category--selected,
.category--selected:hover {
    background-color: var(--inv-category-selected);
}

.category > .icon {
    width: 30px;
    height: 30px;
    margin-right: 16px;
    -unity-background-image-tint-color: var(--text-body);
}

.category--selected > .icon {
    -unity-background-image-tint-color: var(--tab-selected-text);
}

.category-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 20px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.category--selected > .category-name {
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--tab-selected-text);
}

/* The items in the middle: a heading, then the well of slots. */
.items {
    flex-grow: 1;
    padding: 18px 20px 20px 20px;
}

.items-heading {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin-bottom: 14px;
}

.items-title {
    flex-grow: 1;
    margin: 0;
}

/* What the player carries, as the mockup's count: an icon and a figure, gold when nearly full, red
   when full (InventoryScreen.ShowCarry). */
.carry-count {
    flex-direction: row;
    align-items: center;
    margin-left: 22px;
}

.carry-count-icon {
    width: 26px;
    height: 26px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--text-muted);
}

.carry-count-text {
    font-size: 19px;
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.carry-count-text--high {
    color: var(--accent);
}

.carry-count-text--full {
    color: var(--danger);
}

/* The search, a small dark well with a magnifier and a hint while it is empty. */
.item-search-box {
    flex-direction: row;
    align-items: center;
    width: 240px;
    height: 40px;
    margin: 0;
    padding-left: 12px;
    background-color: var(--well);
    border-width: 1px;
    border-color: var(--inv-slot-border);
    border-radius: 6px;
}

.item-search-box--focused {
    border-color: var(--accent);
}

.item-search-icon {
    width: 20px;
    height: 20px;
    -unity-background-image-tint-color: var(--text-muted);
}

.item-search {
    flex-grow: 1;
    margin: 0;
}

.item-search > .unity-base-text-field__input,
.item-search > .unity-text-field__input {
    height: 38px;
    padding: 0 10px;
    font-size: 18px;
    color: var(--text);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    --unity-cursor-color: var(--text);
}

.item-search-hint {
    position: absolute;
    left: 44px;
    top: 8px;
    font-size: 18px;
    color: var(--text-muted);
    margin: 0;
    padding: 0;
}

/* The slots' well: a darker inset with a thin border, the scroll bar along its right. */
.item-well {
    flex-grow: 1;
    padding: 12px 6px 0 12px;
    background-color: #212322;
    border-width: 1px;
    border-color: #3a3c3d;
    border-radius: 6px;
}

.item-grid {
    flex-grow: 1;
    flex-basis: 0;
}

/* An item: its icon on a dark slot, how many at the bottom right. Empty slots fill the grid out.
   Their size is set by InventoryScreen.LayOutSlots, so that whole columns fill the well. */
.item-slot {
    width: 120px;
    height: 120px;
    margin: 0 12px 12px 0;
    align-items: center;
    justify-content: center;
    background-color: var(--inv-slot);
    border-width: 1px;
    border-color: var(--inv-slot-border);
    border-radius: 5px;
}

.item-slot:hover {
    background-color: var(--inv-slot-hover);
    border-color: #6b6d6e;
}

.item-slot--selected,
.item-slot--selected:hover {
    background-color: var(--inv-slot-selected);
    border-color: var(--accent);
    border-width: 3px;
}

.item-slot--empty,
.item-slot--empty:hover {
    background-color: #232524;
    border-color: #363839;
}

.item-icon {
    width: 68%;
    height: 68%;
    -unity-background-scale-mode: scale-to-fit;
}

.item-count {
    position: absolute;
    right: 8px;
    bottom: 4px;
    font-size: 20px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: #ffffff;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    margin: 0;
    padding: 0;
}

.items-empty {
    font-size: 19px;
    color: var(--text-muted);
    white-space: normal;
    margin: 0 6px 12px 0;
}

/* The chosen item, on the right: a cream sheet in a dark frame. */
.inventory-side {
    width: 560px;
    flex-shrink: 0;
    margin: 0 0 0 12px;
    padding: 14px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
}

.details {
    flex-grow: 1;
    padding: 24px 26px 22px 26px;
    background-color: var(--inv-sheet);
    border-width: 1px;
    border-color: var(--inv-sheet-line);
    border-radius: 6px;
}

.details-head {
    flex-direction: row;
    align-items: center;
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom-width: 1px;
    border-color: var(--inv-sheet-line);
}

/* The item's picture, in a frame of its own on the sheet. */
.details-icon-frame {
    width: 136px;
    height: 136px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 22px;
    background-color: #e8dfcf;
    border-width: 1px;
    border-color: #bba98f;
    border-radius: 4px;
}

.details-icon {
    width: 112px;
    height: 112px;
    -unity-background-scale-mode: scale-to-fit;
}

.details-titles {
    flex-shrink: 1;
    align-items: flex-start;
}

.details-name {
    font-size: 28px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    white-space: normal;
    margin: 0 0 4px 0;
    padding: 0;
}

.details-kind {
    font-size: 18px;
    color: var(--inv-sheet-muted);
    margin: 0 0 10px 0;
    padding: 0;
}

/* A small tag under the kind: the item's hotbar slot. */
.details-pill {
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    background-color: var(--inv-sheet-well);
    border-radius: 4px;
    padding: 3px 10px;
    margin: 0;
}

.details-description {
    font-size: 18px;
    color: var(--inv-sheet-text);
    white-space: normal;
    margin: 0 0 18px 0;
    padding: 0;
}

.details-line {
    flex-direction: row;
    align-items: center;
    padding: 11px 0;
    border-top-width: 1px;
    border-color: var(--inv-sheet-line);
}

.details-line-icon {
    width: 22px;
    height: 22px;
    margin-right: 14px;
    -unity-background-image-tint-color: var(--inv-sheet-text);
}

.details-line-label {
    flex-grow: 1;
    font-size: 18px;
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.details-line-value {
    font-size: 18px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.details-section {
    font-size: 20px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 16px 0 10px 0;
    border-top-width: 1px;
    border-color: var(--inv-sheet-line);
}

/* A nutrient: its colour and name, a bar of how rich the food is in it, its points. */
.nutrient {
    flex-direction: row;
    align-items: center;
    margin-bottom: 9px;
}

.nutrient-name {
    width: 86px;
    font-size: 17px;
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.nutrient-bar {
    flex-grow: 1;
    height: 12px;
    margin: 0 14px 0 4px;
    background-color: var(--inv-sheet-well);
    border-radius: 6px;
    overflow: hidden;
}

.nutrient-fill {
    height: 100%;
    width: 0;
    border-radius: 6px;
}

.nutrient-value {
    width: 30px;
    font-size: 17px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}

.details-space {
    flex-grow: 1;
}

/* What can be done with items, keycaps drawn light on the sheet. */
.details-hints {
    padding-top: 14px;
    border-top-width: 1px;
    border-color: var(--inv-sheet-line);
}

.details-hint {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.sheet-key {
    align-items: center;
    justify-content: center;
    min-width: 104px;
    height: 30px;
    padding: 0 10px;
    margin-right: 12px;
    background-color: var(--inv-sheet-well);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: #ae9d87;
    border-radius: 5px;
}

.sheet-key-text {
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.details-hint-text {
    font-size: 16px;
    color: var(--inv-sheet-muted);
    margin: 0;
    padding: 0;
}

/* The dragged item, under the pointer. */
.drag-ghost {
    position: absolute;
    width: 72px;
    height: 72px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.85;
}

/* ---- The crafting tab (CraftingPage) ---- */

/* The recipes, in the place of the categories and items: a heading, then a well of rows. */
.crafting-page {
    flex-grow: 1;
    padding: 18px 20px 20px 20px;
    background-color: var(--inv-main);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
}

.recipe-well {
    padding: 12px 6px 12px 12px;
}

.recipe-list {
    flex-grow: 1;
    flex-basis: 0;
}

/* A recipe: what it makes, then what it takes (red where the bag lacks it), its time and calories. */
.recipe-row {
    flex-direction: row;
    align-items: center;
    height: 92px;
    padding: 0 18px 0 12px;
    margin: 0 10px 10px 0;
    background-color: var(--inv-slot);
    border-width: 1px;
    border-color: var(--inv-slot-border);
    border-radius: 5px;
}

.recipe-row:hover {
    background-color: var(--inv-slot-hover);
    border-color: #6b6d6e;
}

.recipe-row--selected,
.recipe-row--selected:hover {
    border-color: var(--accent);
    border-width: 3px;
}

.recipe-row--unavailable > .recipe-row-icon,
.recipe-row--unavailable > .recipe-row-text {
    opacity: 0.5;
}

.recipe-row-icon {
    width: 68px;
    height: 68px;
    margin-right: 18px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-row-text {
    flex-grow: 1;
}

.recipe-row-name {
    font-size: 21px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0 0 6px 0;
    padding: 0;
}

.recipe-row-cost {
    flex-direction: row;
    align-items: center;
}

.recipe-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 18px;
}

.recipe-chip-icon {
    width: 28px;
    height: 28px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-chip-text {
    font-size: 17px;
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.recipe-chip-text--missing {
    color: var(--danger);
}

.recipe-row-meta {
    align-items: flex-end;
}

.recipe-row-meta-text {
    font-size: 16px;
    color: var(--text-muted);
    margin: 2px 0;
    padding: 0;
}

/* Its sheet: the ingredients scroll when there are many, the actions stay at the foot. */
.recipe-body {
    flex-grow: 1;
    flex-basis: 0;
}

.ingredient-icon {
    width: 40px;
    height: 40px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.ingredient-value--missing {
    color: #a3443a;
}

/* The wood or rock that goes in: Auto, or one the bag holds, chosen in gold-brown; one there is too
   little of, faded. */
.choices {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 0 6px 54px;
}

.choice {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 10px;
    margin: 0 8px 8px 0;
    background-color: var(--inv-sheet-well);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: #ae9d87;
    border-radius: 5px;
}

.choice:hover {
    background-color: #d3c4b0;
}

.choice--selected,
.choice--selected:hover {
    background-color: #efe4d2;
    border-color: #7a5a2c;
    border-width: 2px;
    border-bottom-width: 3px;
}

.choice--short {
    opacity: 0.5;
}

.choice-icon {
    width: 28px;
    height: 28px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.choice-text {
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.recipe-actions {
    padding-top: 14px;
    border-top-width: 1px;
    border-color: var(--inv-sheet-line);
}

.recipe-reason {
    font-size: 16px;
    color: #a3443a;
    white-space: normal;
    margin: 0 0 10px 0;
    padding: 0;
}

.recipe-progress {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.recipe-progress-bar {
    flex-grow: 1;
    height: 14px;
    background-color: var(--inv-sheet-well);
    border-radius: 7px;
    overflow: hidden;
}

.recipe-progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--action);
    border-radius: 7px;
}

.recipe-progress-text {
    font-size: 16px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0 0 0 12px;
    padding: 0;
}

.recipe-buttons {
    flex-direction: row;
}

.recipe-button {
    flex-grow: 1;
    height: 54px;
    font-size: 20px;
}
