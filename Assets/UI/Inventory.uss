/* The inventory screen, after the user's mockup: tabs along the top of a charcoal panel holding the
   categories (a darker column, the chosen one tan) and a well of dark item slots, five or so across
   (InventoryScreen sizes them to fill it), and beside it a dark frame holding the chosen item's cream
   sheet. Sizes are for the 1920 x 1080 reference resolution; the bottom is left free for the hotbar,
   which takes dragged items. */

.inventory-screen {
    --inv-strip: #25292e;
    --inv-column: #252626;
    --inv-main: #2a2c2c;
    --inv-slot: #242625;
    --inv-slot-border: #47494a;
    --inv-slot-hover: #2f3131;
    --inv-slot-selected: #2b2d2c;
    --inv-category-selected: #a4917a;
    --inv-sheet: #ddd0bb;
    --inv-sheet-line: #c9baa6;
    --inv-sheet-text: #1e1711;
    --inv-sheet-muted: #54493e;
    --inv-sheet-well: #c9b9a5;
    padding: 118px 150px 146px 150px;
    background-color: rgba(10, 10, 10, 0.35);
}

.inventory-frame {
    flex-grow: 1;
    flex-direction: row;
}

.inventory-left {
    flex-grow: 1;
}

/* The tab bar, as in the mockup: a bar of its own over about four fifths of the width, above both
   panels, charcoal with a light line along its top and a lighter one along its bottom; the chosen tab
   a tan block set in it, outlined dark and lit along its top, its text dark and bold. */
.inventory-tabs {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    width: 80%;
    height: 68px;
    margin-bottom: 6px;
    padding: 3px 18px 3px 3px;
    background-color: var(--inv-strip);
    border-width: 1px;
    border-top-color: #3b4148;
    border-left-color: #33373c;
    border-right-color: #33373c;
    border-bottom-color: #4a4b4e;
    border-radius: 6px;
}

.inventory-tab {
    flex-direction: row;
    align-items: center;
    height: 100%;
    padding: 0 36px 0 30px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-right-width: 1px;
    border-right-color: #505154;
    border-radius: 0;
}

.inventory-tab:hover {
    background-color: var(--hover);
}

.inventory-tab--selected,
.inventory-tab--selected:hover {
    background-color: #d8c4ab;
    border-width: 1px;
    border-color: #0c0c0d;
    border-top-color: #e5d8c5;
    border-radius: 4px;
}

.inventory-tab-icon {
    width: 28px;
    height: 28px;
    margin-right: 14px;
    -unity-background-image-tint-color: var(--text);
}

.inventory-tab--selected > .inventory-tab-icon {
    -unity-background-image-tint-color: var(--tab-selected-text);
}

.inventory-tab-text {
    font-size: 22px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.inventory-tab--selected > .inventory-tab-text {
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--tab-selected-text);
}

.inventory-tabs-space {
    flex-grow: 1;
}

/* The player's speciality, or the button to choose one. */
.speciality {
    flex-direction: row;
    align-items: center;
}

.speciality > .icon {
    margin-right: 8px;
    -unity-background-image-tint-color: var(--accent);
}

.speciality-name {
    font-size: 18px;
    color: var(--text-muted);
    margin: 0 14px 0 0;
    padding: 0;
}

.speciality-choose {
    height: 42px;
    padding: 0 18px;
    font-size: 17px;
}

.inventory-main {
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--inv-main);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
    overflow: hidden;
}

.column-title {
    font-size: 22px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0 0 16px 0;
    padding: 0;
}

/* Categories down the left, on a darker column. */
.categories {
    width: 270px;
    flex-shrink: 0;
    padding: 22px 12px 12px 12px;
    background-color: var(--inv-column);
    border-right-width: 1px;
    border-color: var(--panel-border);
}

.categories > .column-title {
    margin-left: 10px;
}

.category {
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding: 0 16px;
    margin: 0 0 6px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
}

.category:hover {
    background-color: var(--hover);
}

.category--selected,
.category--selected:hover {
    background-color: var(--inv-category-selected);
}

.category > .icon {
    width: 30px;
    height: 30px;
    margin-right: 16px;
    -unity-background-image-tint-color: var(--text-body);
}

.category--selected > .icon {
    -unity-background-image-tint-color: var(--tab-selected-text);
}

.category-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 20px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.category--selected > .category-name {
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--tab-selected-text);
}

/* The items in the middle: a heading, then the well of slots. */
.items {
    flex-grow: 1;
    padding: 18px 20px 20px 20px;
}

.items-heading {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin-bottom: 14px;
}

.items-title {
    flex-grow: 1;
    margin: 0;
}

/* What the player carries, as the mockup's count: an icon and a figure, gold when nearly full, red
   when full (InventoryScreen.ShowCarry). */
.carry-count {
    flex-direction: row;
    align-items: center;
    margin-left: 22px;
}

.carry-count-icon {
    width: 26px;
    height: 26px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--text-muted);
}

.carry-count-text {
    font-size: 19px;
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.carry-count-text--high {
    color: var(--accent);
}

.carry-count-text--full {
    color: var(--danger);
}

/* The search, a small dark well with a magnifier and a hint while it is empty. */
.item-search-box {
    flex-direction: row;
    align-items: center;
    width: 240px;
    height: 40px;
    margin: 0;
    padding-left: 12px;
    background-color: var(--well);
    border-width: 1px;
    border-color: var(--inv-slot-border);
    border-radius: 6px;
}

.item-search-box--focused {
    border-color: var(--accent);
}

.item-search-icon {
    width: 20px;
    height: 20px;
    -unity-background-image-tint-color: var(--text-muted);
}

.item-search {
    flex-grow: 1;
    margin: 0;
}

.item-search > .unity-base-text-field__input,
.item-search > .unity-text-field__input {
    height: 38px;
    padding: 0 10px;
    font-size: 18px;
    color: var(--text);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    --unity-cursor-color: var(--text);
}

.item-search-hint {
    position: absolute;
    left: 44px;
    top: 8px;
    font-size: 18px;
    color: var(--text-muted);
    margin: 0;
    padding: 0;
}

/* The slots' well: a darker inset with a thin border, the scroll bar along its right. */
.item-well {
    flex-grow: 1;
    padding: 12px 6px 0 12px;
    background-color: #212322;
    border-width: 1px;
    border-color: #3a3c3d;
    border-radius: 6px;
}

.item-grid {
    flex-grow: 1;
    flex-basis: 0;
}

/* An item: its icon on a dark slot, how many at the bottom right. Empty slots fill the grid out.
   Their size is set by InventoryScreen.LayOutSlots, so that whole columns fill the well. */
.item-slot {
    width: 120px;
    height: 120px;
    margin: 0 12px 12px 0;
    align-items: center;
    justify-content: center;
    background-color: var(--inv-slot);
    border-width: 1px;
    border-color: var(--inv-slot-border);
    border-radius: 5px;
}

.item-slot:hover {
    background-color: var(--inv-slot-hover);
    border-color: #6b6d6e;
}

.item-slot--selected,
.item-slot--selected:hover {
    background-color: var(--inv-slot-selected);
    border-color: var(--accent);
    border-width: 3px;
}

.item-slot--empty,
.item-slot--empty:hover {
    background-color: #232524;
    border-color: #363839;
}

.item-icon {
    width: 68%;
    height: 68%;
    -unity-background-scale-mode: scale-to-fit;
}

.item-count {
    position: absolute;
    right: 8px;
    bottom: 4px;
    font-size: 20px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: #ffffff;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    margin: 0;
    padding: 0;
}

.items-empty {
    font-size: 19px;
    color: var(--text-muted);
    white-space: normal;
    margin: 0 6px 12px 0;
}

/* The chosen item, on the right: a cream sheet in a dark frame. */
.inventory-side {
    width: 560px;
    flex-shrink: 0;
    margin: 0 0 0 12px;
    padding: 14px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
}

.details {
    flex-grow: 1;
    padding: 24px 26px 22px 26px;
    background-color: var(--inv-sheet);
    border-width: 1px;
    border-color: var(--inv-sheet-line);
    border-radius: 6px;
}

.details-head {
    flex-direction: row;
    align-items: center;
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom-width: 1px;
    border-color: var(--inv-sheet-line);
}

/* The item's picture, in a frame of its own on the sheet. */
.details-icon-frame {
    width: 136px;
    height: 136px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 22px;
    background-color: #e8dfcf;
    border-width: 1px;
    border-color: #bba98f;
    border-radius: 4px;
}

.details-icon {
    width: 112px;
    height: 112px;
    -unity-background-scale-mode: scale-to-fit;
}

.details-titles {
    flex-shrink: 1;
    align-items: flex-start;
}

.details-name {
    font-size: 28px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    white-space: normal;
    margin: 0 0 4px 0;
    padding: 0;
}

.details-kind {
    font-size: 18px;
    color: var(--inv-sheet-muted);
    margin: 0 0 10px 0;
    padding: 0;
}

/* A small tag under the kind: the item's hotbar slot. */
.details-pill {
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    background-color: var(--inv-sheet-well);
    border-radius: 4px;
    padding: 3px 10px;
    margin: 0;
}

.details-description {
    font-size: 18px;
    color: var(--inv-sheet-text);
    white-space: normal;
    margin: 0 0 18px 0;
    padding: 0;
}

.details-line {
    flex-direction: row;
    align-items: center;
    padding: 11px 0;
    border-top-width: 1px;
    border-color: var(--inv-sheet-line);
}

.details-line-icon {
    width: 22px;
    height: 22px;
    margin-right: 14px;
    -unity-background-image-tint-color: var(--inv-sheet-text);
}

.details-line-label {
    flex-grow: 1;
    font-size: 18px;
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.details-line-value {
    font-size: 18px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.details-section {
    font-size: 20px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 16px 0 10px 0;
    border-top-width: 1px;
    border-color: var(--inv-sheet-line);
}

/* A nutrient: its colour and name, a bar of how rich the food is in it, its points. */
.nutrient {
    flex-direction: row;
    align-items: center;
    margin-bottom: 9px;
}

.nutrient-name {
    width: 86px;
    font-size: 17px;
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.nutrient-bar {
    flex-grow: 1;
    height: 12px;
    margin: 0 14px 0 4px;
    background-color: var(--inv-sheet-well);
    border-radius: 6px;
    overflow: hidden;
}

.nutrient-fill {
    height: 100%;
    width: 0;
    border-radius: 6px;
}

.nutrient-value {
    width: 30px;
    font-size: 17px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}

.details-space {
    flex-grow: 1;
}

/* What can be done with items, keycaps drawn light on the sheet. */
.details-hints {
    padding-top: 14px;
    border-top-width: 1px;
    border-color: var(--inv-sheet-line);
}

.details-hint {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.sheet-key {
    align-items: center;
    justify-content: center;
    min-width: 104px;
    height: 30px;
    padding: 0 10px;
    margin-right: 12px;
    background-color: var(--inv-sheet-well);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: #ae9d87;
    border-radius: 5px;
}

.sheet-key-text {
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.details-hint-text {
    font-size: 16px;
    color: var(--inv-sheet-muted);
    margin: 0;
    padding: 0;
}

/* The dragged item, under the pointer. */
.drag-ghost {
    position: absolute;
    width: 72px;
    height: 72px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.85;
}

/* ---- The crafting tab (CraftingPage) ---- */

/* The recipes, in the place of the categories and items: a heading, then a well of rows. */
.crafting-page {
    flex-grow: 1;
    padding: 18px 20px 20px 20px;
    background-color: var(--inv-main);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
}

.recipe-well {
    padding: 12px 6px 12px 12px;
}

.recipe-list {
    flex-grow: 1;
    flex-basis: 0;
}

/* A recipe: what it makes, then what it takes (red where the bag lacks it), its time and calories. */
.recipe-row {
    flex-direction: row;
    align-items: center;
    height: 92px;
    padding: 0 18px 0 12px;
    margin: 0 10px 10px 0;
    background-color: var(--inv-slot);
    border-width: 1px;
    border-color: var(--inv-slot-border);
    border-radius: 5px;
}

.recipe-row:hover {
    background-color: var(--inv-slot-hover);
    border-color: #6b6d6e;
}

.recipe-row--selected,
.recipe-row--selected:hover {
    border-color: var(--accent);
    border-width: 3px;
}

.recipe-row--unavailable > .recipe-row-icon,
.recipe-row--unavailable > .recipe-row-text {
    opacity: 0.5;
}

.recipe-row-icon {
    width: 68px;
    height: 68px;
    margin-right: 18px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-row-text {
    flex-grow: 1;
}

.recipe-row-name {
    font-size: 21px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0 0 6px 0;
    padding: 0;
}

.recipe-row-cost {
    flex-direction: row;
    align-items: center;
}

.recipe-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 18px;
}

.recipe-chip-icon {
    width: 28px;
    height: 28px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-chip-text {
    font-size: 17px;
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.recipe-chip-text--missing {
    color: var(--danger);
}

.recipe-row-meta {
    align-items: flex-end;
}

.recipe-row-meta-text {
    font-size: 16px;
    color: var(--text-muted);
    margin: 2px 0;
    padding: 0;
}

/* Its sheet: the ingredients scroll when there are many, the actions stay at the foot. */
.recipe-body {
    flex-grow: 1;
    flex-basis: 0;
}

.ingredient-icon {
    width: 40px;
    height: 40px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.ingredient-value--missing {
    color: #a3443a;
}

/* The wood or rock that goes in: Auto, or one the bag holds, chosen in gold-brown; one there is too
   little of, faded. */
.choices {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 0 6px 54px;
}

.choice {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 10px;
    margin: 0 8px 8px 0;
    background-color: var(--inv-sheet-well);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: #ae9d87;
    border-radius: 5px;
}

.choice:hover {
    background-color: #d3c4b0;
}

.choice--selected,
.choice--selected:hover {
    background-color: #efe4d2;
    border-color: #7a5a2c;
    border-width: 2px;
    border-bottom-width: 3px;
}

.choice--short {
    opacity: 0.5;
}

.choice-icon {
    width: 28px;
    height: 28px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.choice-text {
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.recipe-actions {
    padding-top: 14px;
    border-top-width: 1px;
    border-color: var(--inv-sheet-line);
}

.recipe-reason {
    font-size: 16px;
    color: #a3443a;
    white-space: normal;
    margin: 0 0 10px 0;
    padding: 0;
}

.recipe-progress {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.recipe-progress-bar {
    flex-grow: 1;
    height: 14px;
    background-color: var(--inv-sheet-well);
    border-radius: 7px;
    overflow: hidden;
}

.recipe-progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--action);
    border-radius: 7px;
}

.recipe-progress-text {
    font-size: 16px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0 0 0 12px;
    padding: 0;
}

.recipe-buttons {
    flex-direction: row;
}

.recipe-button {
    flex-grow: 1;
    height: 54px;
    font-size: 20px;
}

/* An order may be queued without its ingredients: said in amber, not red. */
.recipe-reason--warning {
    color: #8a5a12;
}

/* Where an ingredient is found, under its line on a campfire's sheet. */
.ingredient-source {
    font-size: 14px;
    color: var(--inv-sheet-muted);
    margin: -6px 0 8px 54px;
    padding: 0;
}

/* A recipe row's time and calories, each with its glyph. */
.recipe-row-meta-line {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.recipe-row-meta-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    -unity-background-image-tint-color: var(--text-muted);
}

/* How many to make (QuantityStepper). */
.stepper {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.stepper-title {
    flex-grow: 1;
    font-size: 17px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--inv-sheet-text);
    margin: 0;
    padding: 0;
}

.stepper-button {
    width: 44px;
    height: 40px;
    margin: 0;
    padding: 0;
    font-size: 22px;
    color: var(--inv-sheet-text);
    background-color: var(--inv-sheet-well);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: #ae9d87;
    border-radius: 5px;
}

.stepper-button:hover {
    background-color: #d3c4b0;
}

/* The count, typed on the sheet's cream: a small inset field. */
.stepper-field {
    width: 64px;
    margin: 0 8px;
}

.stepper-field > .unity-base-text-field__input,
.stepper-field > .unity-text-field__input {
    height: 40px;
    padding: 0 6px;
    font-size: 21px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    -unity-text-align: middle-center;
    color: var(--inv-sheet-text);
    background-color: #efe4d2;
    border-width: 1px;
    border-color: #ae9d87;
    border-radius: 5px;
    --unity-cursor-color: var(--inv-sheet-text);
}

.stepper-field:focus > .unity-base-text-field__input,
.stepper-field:focus > .unity-text-field__input {
    border-color: #7a5a2c;
    border-width: 2px;
}

.stepper-max {
    width: auto;
    padding: 0 14px;
    margin-left: 12px;
    font-size: 16px;
}

/* The queue under the recipes: a title, then a well of orders. */
.queue-title {
    font-size: 18px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text-body);
    margin: 14px 0 8px 2px;
    padding: 0;
}

.queue-well {
    flex-grow: 0;
    flex-shrink: 0;
    height: 240px;
    padding: 10px 4px 2px 10px;
}

.queue-list {
    flex-grow: 1;
    flex-basis: 0;
}

/* An order on a queue (OrderRows): its icon, its name and a line under it, a bar (calories put in,
   cooking, or the item under way) with what it waits for, and its buttons. */
.job-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 10px 10px 8px;
    margin: 0 8px 8px 0;
    background-color: var(--inv-slot);
    border-width: 1px;
    border-color: var(--inv-slot-border);
    border-radius: 5px;
}

.job-row--cooking {
    border-color: #e39a3b;
}

.job-icon {
    width: 56px;
    height: 56px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.job-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.job-name {
    font-size: 18px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0;
    padding: 0;
}

.job-by {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0 0 6px 0;
    padding: 0;
}

.job-bar {
    height: 10px;
    background-color: var(--well);
    border-radius: 5px;
    overflow: hidden;
}

.job-bar-fill {
    height: 100%;
    width: 0;
    background-color: var(--action-hover);
    border-radius: 5px;
}

.job-bar-fill--cooking {
    background-color: #e39a3b;
}

/* A bar and what it reads after it: on a campfire, the calories put in above the cooking. */
.job-bar-line {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.job-bar-line > .job-bar {
    flex-grow: 1;
}

.job-bar-fill--labour {
    background-color: #7fae6b;
}

.job-bar-text {
    width: 130px;
    flex-shrink: 0;
    font-size: 13px;
    -unity-text-align: middle-right;
    color: var(--text-muted);
    margin: 0 0 0 8px;
    padding: 0;
}

.job-status {
    font-size: 15px;
    color: var(--text-body);
    margin: 4px 0 0 0;
    padding: 0;
}

.job-status--waiting {
    color: var(--accent);
}

.job-labour {
    height: 40px;
    padding: 0 12px;
    margin-left: 10px;
    font-size: 16px;
}

.job-cancel {
    width: 40px;
    height: 40px;
    padding: 0;
    margin-left: 6px;
    font-size: 18px;
}

/* ---- The creative tab (CreativePage) ---- */

/* Creative mode on or off, a reminder of what it does, then the categories and every item. */
.creative-page {
    flex-grow: 1;
    background-color: var(--inv-main);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
    overflow: hidden;
}

.creative-head {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    border-bottom-width: 1px;
    border-color: var(--panel-border);
    background-color: var(--inv-column);
}

.creative-toggle {
    flex-direction: row;
    align-items: center;
    height: 42px;
    padding: 0 18px;
    font-size: 17px;
    margin-right: 18px;
}

.creative-toggle-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 10px;
    background-color: #6c6e6f;
}

.creative-toggle--on {
    background-color: var(--action);
}

.creative-toggle--on > .creative-toggle-dot {
    background-color: var(--accent);
}

.creative-hint {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 16px;
    color: var(--text-muted);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.creative-body {
    flex-grow: 1;
    flex-direction: row;
}

/* Out of creative mode the catalog is greyed and takes no clicks (ItemGrid). */
.item-slot--dimmed,
.item-slot--dimmed:hover {
    opacity: 0.32;
}

/* ---- The skills tab (SkillsPage), after the user's mockup ---- */

/* Parchment cards on dark tier bands, gold for what is mastered, green for what can be bought. */
.skills-page {
    --skill-parchment: #ddd2bd;
    --skill-parchment-hover: #e8decb;
    --skill-parchment-edge: #b8a68a;
    --skill-ink: #1e1711;
    --skill-ink-muted: #5a4e40;
    --skill-gold: #d9ad4f;
    --skill-gold-light: #ecd290;
    --skill-gold-edge: #b8862c;
    --skill-green: #5fa645;
    --skill-green-dark: #3f7d2c;
    --skill-band: rgba(16, 17, 18, 0.72);
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--inv-main);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
    overflow: hidden;
}

/* With the skills tab the sheet on the right is narrower, as in the mockup. */
.inventory-screen--skills .inventory-side {
    width: 400px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* The skills down the left, as categories. */
.skills-column {
    width: 250px;
}

.skill-search-box {
    margin: 0 0 14px 0;
    width: auto;
}

.skill-list {
    flex-grow: 1;
}

.skill-row {
    height: 64px;
}

.skill-row--locked {
    opacity: 0.5;
}

.skill-row-icon {
    width: 40px;
    height: 40px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-row-text {
    flex-grow: 1;
    justify-content: center;
}

.skill-row-text > .category-name {
    flex-grow: 0;
}

.skill-row-status {
    -unity-text-align: middle-left;
    font-size: 15px;
    color: var(--text-muted);
    margin: 2px 0 0 0;
    padding: 0;
}

.category--selected .skill-row-status {
    color: var(--inv-sheet-muted);
}

/* Points left to spend in a skill: a gold pill. */
.skill-row-points {
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    -unity-text-align: middle-center;
    font-size: 16px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--tab-selected-text);
    background-color: var(--accent);
    border-radius: 15px;
    margin: 0;
}

.skill-summary {
    padding: 12px 14px;
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
}

.skill-summary-line {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 3px 0;
}

.skill-summary-label {
    flex-shrink: 1;
    font-size: 14px;
    color: var(--text-muted);
    margin: 0 10px 0 0;
    padding: 0;
}

.skill-summary-value {
    font-size: 16px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--accent);
    margin: 0;
    padding: 0;
}

/* ---- The chosen skill ---- */

.skill-main {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 18px 16px 12px 20px;
}

.skill-header {
    flex-direction: row;
    align-items: center;
    padding: 0 6px 14px 0;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-color: var(--line);
}

.skill-header-icon {
    width: 78px;
    height: 78px;
    margin-right: 18px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-header-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.skill-title {
    font-size: 38px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    letter-spacing: 3px;
    color: #f1e6cf;
    margin: 0 0 4px 0;
    padding: 0;
}

.skill-subtitle {
    font-size: 16px;
    color: var(--text-body);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.skill-header-side {
    width: 240px;
    flex-shrink: 0;
    align-items: flex-end;
    margin-left: 16px;
}

.skill-header-points {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    margin-bottom: 8px;
    background-color: rgba(217, 173, 79, 0.18);
    border-width: 1px;
    border-color: var(--skill-gold-edge);
    border-radius: 16px;
}

.skill-header-points-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--skill-gold);
}

.skill-header-points-text {
    font-size: 16px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--skill-gold-light);
    margin: 0;
    padding: 0;
}

.skill-header-tier {
    font-size: 15px;
    color: var(--text-body);
    -unity-text-align: middle-right;
    white-space: normal;
    margin: 0 0 6px 0;
    padding: 0;
}

.skill-header-bar {
    width: 100%;
    height: 10px;
    background-color: var(--well);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 5px;
    overflow: hidden;
}

.skill-header-bar-fill {
    height: 100%;
    width: 0;
    background-color: var(--skill-gold);
}

.skill-header-xp {
    font-size: 13px;
    color: var(--text-muted);
    margin: 4px 0 0 0;
    padding: 0;
}

.skill-tiers-box {
    flex-grow: 1;
    flex-basis: 0;
}

.skill-tiers {
    flex-grow: 1;
    flex-basis: 0;
}

.skill-condition {
    font-size: 17px;
    color: var(--accent);
    white-space: normal;
    margin: 0 10px 12px 0;
    padding: 0;
}

/* ---- The tiers: one panel, a row of upgrades per tier beside the rail (SkillsPage.Band) ---- */

.skill-tree {
    margin: 0 10px 12px 0;
    padding: 14px 10px 0 4px;
    background-color: var(--skill-band);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 6px;
}

.skill-tier {
    flex-direction: row;
}

/* The rail: the tier's number on a disc, and a bar from it down to the next tier's disc. */
.skill-rail {
    width: 64px;
    flex-shrink: 0;
    align-items: center;
}

.skill-rail-number {
    width: 40px;
    height: 40px;
    margin: 10px 0 0 0;
    padding: 0;
    border-width: 2px;
    border-radius: 20px;
    border-color: rgba(255, 255, 255, 0.22);
    background-color: #1c1d1f;
    -unity-text-align: middle-center;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    font-size: 19px;
    color: var(--text-muted);
}

.skill-tier--current .skill-rail-number {
    border-color: var(--skill-gold);
    color: var(--skill-gold-light);
}

.skill-tier--done .skill-rail-number {
    background-color: var(--skill-gold);
    border-color: var(--skill-gold-edge);
    color: var(--skill-ink);
}

/* From the disc's centre (10 + 20) to the next one's, the same height below. */
.skill-rail-bar {
    position: absolute;
    left: 29px;
    width: 6px;
    top: 30px;
    bottom: -30px;
    background-color: var(--well);
    border-radius: 3px;
}

.skill-rail-bar--last {
    bottom: 14px;
}

.skill-rail-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    background-color: var(--skill-green);
    border-radius: 3px;
}

.skill-tier--done .skill-rail-fill {
    background-color: var(--skill-gold);
}

.skill-rail-tick {
    position: absolute;
    left: -2px;
    right: -2px;
    height: 2px;
    margin-top: -1px;
    background-color: rgba(16, 17, 18, 0.9);
}

/* The bottom margin is SkillsPage.BandGap, where the links turn. */
.skill-tier-cards {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    padding: 10px 8px 0 8px;
    margin-bottom: 22px;
}

.skill-tier--closed > .skill-tier-cards {
    opacity: 0.5;
}

/* The gold lines from each level to the next one (SkillsPage.DrawLinks). */
.skill-links {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---- An upgrade's card ---- */

/* The icon and name on top, the pips (or the value) across the card below. */
.skill-card {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    flex-basis: 0;
    max-width: 260px;
    min-height: 104px;
    margin: 0 5px;
    padding: 8px;
    background-color: var(--skill-parchment);
    border-width: 2px;
    border-color: var(--skill-parchment-edge);
    border-radius: 5px;
}

.skill-card:hover {
    background-color: var(--skill-parchment-hover);
}

.skill-card--available {
    border-color: var(--skill-green);
}

.skill-card--locked > .skill-card-top,
.skill-card--locked > .skill-card-foot {
    opacity: 0.55;
}

.skill-card-top {
    flex-direction: row;
    align-items: center;
}

.skill-card-foot {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

/* A one-step upgrade showing its value: gold once it is bought. */
.skill-card--gold {
    background-color: var(--skill-gold-light);
    border-color: var(--skill-gold-edge);
}

.skill-card--gold:hover {
    background-color: #f2dda4;
}

.skill-card--selected,
.skill-card--selected:hover {
    border-color: var(--skill-gold);
    border-width: 3px;
}

.skill-card-icon-frame {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    margin-right: 9px;
    background-color: #2b2d2c;
    border-width: 2px;
    border-color: #5b4f3d;
    border-radius: 4px;
}

.skill-card--gold .skill-card-icon-frame {
    border-color: var(--skill-gold-edge);
}

.skill-card-icon {
    flex-grow: 1;
    margin: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-card-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.skill-card-name {
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    -unity-text-align: upper-left;
    white-space: normal;
    color: var(--skill-ink);
    margin: 0 0 2px 0;
    padding: 0;
}

.skill-card-rank {
    font-size: 13px;
    -unity-text-align: upper-left;
    color: var(--skill-ink-muted);
    margin: 0;
    padding: 0;
}

.skill-card-value {
    font-size: 28px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    -unity-text-align: middle-center;
    color: var(--skill-ink);
    margin: 0;
    padding: 0;
}

.skill-pips {
    flex-direction: row;
    justify-content: center;
}

.skill-pip-column {
    width: 30px;
    align-items: center;
}

.skill-pip {
    width: 16px;
    height: 16px;
    border-width: 2px;
    border-color: var(--skill-green);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.35);
}

.skill-pip--bought {
    background-color: var(--skill-green);
    border-color: var(--skill-green-dark);
}

.skill-pip--closed {
    border-color: #9a8f7b;
    background-color: #b8ad98;
}

.skill-pip-label {
    font-size: 12px;
    color: var(--skill-ink-muted);
    margin: 2px 0 0 0;
    padding: 0;
}

/* An upgrade with options: a framed group with a card per option. */
.skill-group {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 820px;
    margin: 0 5px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 5px;
}

.skill-group--selected {
    border-color: var(--skill-gold);
}

.skill-group-head {
    flex-direction: row;
    align-items: center;
    padding: 7px 12px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.skill-group-title {
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    letter-spacing: 2px;
    color: #f1e6cf;
    margin: 0 14px 0 0;
    padding: 0;
}

.skill-group-limit {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
    padding: 0;
}

.skill-group-row {
    flex-direction: row;
    justify-content: center;
    padding: 10px 5px;
}

.skill-card--choice {
    max-width: 230px;
    min-height: 86px;
}

/* ---- The dark sheet on the right ---- */

.skill-sheet {
    flex-grow: 1;
    padding: 20px 20px 18px 20px;
    background-color: rgba(18, 19, 20, 0.92);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
}

.skill-sheet-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.skill-sheet-icon-frame {
    width: 104px;
    height: 104px;
    flex-shrink: 0;
    margin-right: 16px;
    background-color: #2b2d2c;
    border-width: 2px;
    border-color: #8a6d3b;
    border-radius: 6px;
}

.skill-sheet-icon {
    flex-grow: 1;
    margin: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-sheet-titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.skill-sheet-name {
    font-size: 26px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    white-space: normal;
    margin: 0 0 4px 0;
    padding: 0;
}

.skill-sheet-kind {
    font-size: 16px;
    color: #d9a441;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.skill-sheet-body {
    flex-grow: 1;
    flex-basis: 0;
}

.skill-sheet-description {
    font-size: 16px;
    color: var(--text-body);
    white-space: normal;
    margin: 0 0 14px 0;
    padding: 0;
}

/* The bonus now, in a box of its own, then a row for each fact. */
.skill-info-box {
    padding: 10px 14px;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
}

.skill-info-title {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0 0 2px 0;
    padding: 0;
}

.skill-info-big {
    font-size: 28px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.skill-info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 9px 14px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
}

.skill-info-label {
    font-size: 15px;
    color: var(--text-body);
    margin: 0;
    padding: 0;
}

.skill-info-value {
    font-size: 15px;
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
    color: var(--text);
    margin: 0;
    padding: 0;
}

.skill-requirement {
    flex-direction: row;
    align-items: center;
    margin: 5px 0 0 0;
}

.skill-requirement-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 10px;
    -unity-background-image-tint-color: var(--skill-green);
}

.skill-requirement--missing > .skill-requirement-icon {
    -unity-background-image-tint-color: var(--danger);
}

.skill-requirement-text {
    font-size: 14px;
    color: var(--text-body);
    white-space: normal;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
}

.skill-requirement--missing > .skill-requirement-text {
    color: var(--text-muted);
}

.skill-effect {
    font-size: 15px;
    color: var(--text-body);
    white-space: normal;
    margin: 0 0 6px 0;
    padding: 0;
}

/* The options of an upgrade with choices, on the dark sheet. */
.skill-choices {
    flex-direction: row;
    flex-wrap: wrap;
}

.skill-choice {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: var(--line);
}

.skill-choice:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.skill-choice.choice--selected,
.skill-choice.choice--selected:hover {
    background-color: rgba(217, 173, 79, 0.2);
    border-color: var(--skill-gold);
}

.skill-choice > .choice-text {
    color: var(--text);
}

.skill-technical {
    font-size: 13px;
    color: var(--text-muted);
    white-space: normal;
    margin: 12px 0 0 0;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 5px;
}

.skill-sheet-reason {
    font-size: 15px;
    color: var(--danger);
    white-space: normal;
    margin: 10px 0 8px 0;
    padding: 0;
}

.skill-sheet-reason--done {
    color: var(--skill-gold);
}

.skill-sheet-buy {
    height: 58px;
    font-size: 21px;
}

/* ---- The keys at the foot ---- */

.skill-footer {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
}
