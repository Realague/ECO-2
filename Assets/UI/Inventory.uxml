<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Common.uss" />
    <Style src="Inventory.uss" />

    <!-- InventoryScreen fills the categories, the grid of items (with empty slots after them), the
         details of the chosen or hovered one and the speciality, and moves the dragged item's ghost. -->
    <ui:VisualElement name="screen" class="screen inventory-screen">
        <!-- The tab bar, a bar of its own above both panels as in the mockup, the speciality at its end. -->
        <ui:VisualElement class="inventory-tabs">
            <ui:Button name="tab-inventory" class="inventory-tab inventory-tab--selected">
                <ui:VisualElement class="icon icon--tab-inventory inventory-tab-icon" />
                <ui:Label text="Inventory" class="inventory-tab-text" />
            </ui:Button>
            <ui:Button name="tab-crafting" class="inventory-tab">
                <ui:VisualElement class="icon icon--category-tools inventory-tab-icon" />
                <ui:Label text="Crafting" class="inventory-tab-text" />
            </ui:Button>
            <ui:VisualElement class="inventory-tabs-space" />
            <ui:VisualElement class="speciality">
                <ui:VisualElement class="icon icon--plant" />
                <ui:Label name="speciality-name" class="speciality-name" />
                <ui:Button name="speciality-choose" class="button button--primary speciality-choose">
                    <ui:Label text="Become a gardener" class="button-text" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="inventory-frame">
            <ui:VisualElement class="inventory-left">
                <ui:VisualElement class="inventory-main">
                    <ui:VisualElement class="categories">
                        <ui:Label text="Categories" class="column-title" />
                        <ui:ScrollView name="category-list" class="category-list" />
                    </ui:VisualElement>

                    <ui:VisualElement class="items">
                        <!-- The title, a search, and what the player carries (InventoryScreen.ShowCarry). -->
                        <ui:VisualElement class="items-heading">
                            <ui:Label text="Your items" class="column-title items-title" />
                            <ui:VisualElement class="item-search-box">
                                <ui:VisualElement class="icon icon--search item-search-icon" picking-mode="Ignore" />
                                <ui:TextField name="item-search" max-length="32" class="item-search" />
                                <ui:Label name="item-search-hint" text="Search" class="item-search-hint" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="carry-count" tooltip="Blocks carried (40 at most)">
                                <ui:VisualElement class="icon icon--backpack carry-count-icon" />
                                <ui:Label name="carry-blocks" class="carry-count-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="carry-count" tooltip="Weight of everything else (30 kg at most)">
                                <ui:VisualElement class="icon icon--scales carry-count-icon" />
                                <ui:Label name="carry-weight" class="carry-count-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <!-- The slots, in a well; InventoryScreen sizes them to fill its width. -->
                        <ui:VisualElement class="item-well">
                            <ui:Label name="item-empty" class="items-empty" text="Nothing here yet: break blocks, fell trees and harvest ripe crops." />
                            <ui:ScrollView name="item-grid" class="item-grid" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- The crafting tab (CraftingPage): every recipe, what it takes and whether the bag holds it. -->
                <ui:VisualElement name="crafting-page" class="crafting-page">
                    <ui:VisualElement class="items-heading">
                        <ui:Label text="Recipes" class="column-title items-title" />
                        <ui:VisualElement class="carry-count" tooltip="Your calories: crafting burns them">
                            <ui:VisualElement class="icon icon--fire carry-count-icon" />
                            <ui:Label name="crafting-calories" class="carry-count-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="item-well recipe-well">
                        <ui:ScrollView name="recipe-list" class="recipe-list" />
                    </ui:VisualElement>
                    <!-- The queue: orders made one after another, waiting for their ingredients if need be. -->
                    <ui:Label name="craft-queue-title" text="Queue" class="queue-title" />
                    <ui:VisualElement class="item-well queue-well">
                        <ui:Label name="craft-queue-empty" text="Nothing queued: choose a recipe, then Add to the queue." class="items-empty" />
                        <ui:ScrollView name="craft-queue" class="queue-list" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- The chosen item (or the one under the pointer), on a cream sheet in a dark frame. -->
            <ui:VisualElement class="inventory-side">
                <ui:VisualElement name="details" class="details">
                    <ui:VisualElement class="details-head">
                        <ui:VisualElement class="details-icon-frame">
                            <ui:VisualElement name="details-icon" class="details-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="details-titles">
                            <ui:Label name="details-name" class="details-name" />
                            <ui:Label name="details-kind" class="details-kind" />
                            <ui:Label name="details-slot" class="details-pill" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="details-description" class="details-description" />
                    <ui:VisualElement class="details-line">
                        <ui:VisualElement class="icon icon--backpack details-line-icon" />
                        <ui:Label text="In your bag" class="details-line-label" />
                        <ui:Label name="details-count" class="details-line-value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="details-weight-line" class="details-line">
                        <ui:VisualElement class="icon icon--scales details-line-icon" />
                        <ui:Label text="Weight" class="details-line-label" />
                        <ui:Label name="details-weight" class="details-line-value" />
                    </ui:VisualElement>
                    <!-- Fuel only: how long one burns on a campfire. -->
                    <ui:VisualElement name="details-burn-line" class="details-line">
                        <ui:VisualElement class="icon icon--fire details-line-icon" />
                        <ui:Label text="Burn time" class="details-line-label" />
                        <ui:Label name="details-burn" class="details-line-value" />
                    </ui:VisualElement>
                    <!-- Food only: its calories, and its nutrients in the stomach pie's colours. -->
                    <ui:VisualElement name="details-food">
                        <ui:VisualElement class="details-line">
                            <ui:VisualElement class="icon icon--fire details-line-icon" />
                            <ui:Label text="Calories" class="details-line-label" />
                            <ui:Label name="details-calories" class="details-line-value" />
                        </ui:VisualElement>
                        <ui:Label text="Nutrition" class="details-section" />
                        <ui:VisualElement class="nutrient">
                            <ui:VisualElement class="stomach-dot stomach-dot--carbs" />
                            <ui:Label text="Carbs" class="nutrient-name" />
                            <ui:VisualElement class="nutrient-bar"><ui:VisualElement name="details-nutrient-bar-0" class="nutrient-fill stomach-dot--carbs" /></ui:VisualElement>
                            <ui:Label name="details-nutrient-0" class="nutrient-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="nutrient">
                            <ui:VisualElement class="stomach-dot stomach-dot--protein" />
                            <ui:Label text="Protein" class="nutrient-name" />
                            <ui:VisualElement class="nutrient-bar"><ui:VisualElement name="details-nutrient-bar-1" class="nutrient-fill stomach-dot--protein" /></ui:VisualElement>
                            <ui:Label name="details-nutrient-1" class="nutrient-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="nutrient">
                            <ui:VisualElement class="stomach-dot stomach-dot--fat" />
                            <ui:Label text="Fat" class="nutrient-name" />
                            <ui:VisualElement class="nutrient-bar"><ui:VisualElement name="details-nutrient-bar-2" class="nutrient-fill stomach-dot--fat" /></ui:VisualElement>
                            <ui:Label name="details-nutrient-2" class="nutrient-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="nutrient">
                            <ui:VisualElement class="stomach-dot stomach-dot--vitamins" />
                            <ui:Label text="Vitamins" class="nutrient-name" />
                            <ui:VisualElement class="nutrient-bar"><ui:VisualElement name="details-nutrient-bar-3" class="nutrient-fill stomach-dot--vitamins" /></ui:VisualElement>
                            <ui:Label name="details-nutrient-3" class="nutrient-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="details-space" />

                    <!-- What can be done with items, where the sheet would have buttons. -->
                    <ui:VisualElement class="details-hints">
                        <ui:VisualElement class="details-hint">
                            <ui:VisualElement class="sheet-key"><ui:Label text="Drag" class="sheet-key-text" /></ui:VisualElement>
                            <ui:Label text="to a hotbar slot" class="details-hint-text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="details-hint">
                            <ui:VisualElement class="sheet-key"><ui:Label text="1 - 0" class="sheet-key-text" /></ui:VisualElement>
                            <ui:Label text="put in that hotbar slot" class="details-hint-text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="details-hint">
                            <ui:VisualElement class="sheet-key"><ui:Label text="Right click" class="sheet-key-text" /></ui:VisualElement>
                            <ui:Label text="eat food, butcher a carcass (knife), empty a hotbar slot" class="details-hint-text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="details-hint">
                            <ui:VisualElement class="sheet-key"><ui:Label text="Tab" class="sheet-key-text" /></ui:VisualElement>
                            <ui:Label text="close" class="details-hint-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- The chosen recipe (CraftingPage): what it makes, each ingredient with the wood or rock
                     chosen for it, its time and calories, and Craft, or the craft under way. -->
                <ui:VisualElement name="recipe-sheet" class="details recipe-sheet">
                    <ui:VisualElement class="details-head">
                        <ui:VisualElement class="details-icon-frame">
                            <ui:VisualElement name="recipe-icon" class="details-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="details-titles">
                            <ui:Label name="recipe-name" class="details-name" />
                            <ui:Label name="recipe-kind" class="details-kind" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView name="recipe-body" class="recipe-body">
                        <ui:Label name="recipe-description" class="details-description" />
                        <ui:Label text="Ingredients" class="details-section" />
                        <ui:VisualElement name="recipe-ingredients" />
                        <ui:VisualElement class="details-line">
                            <ui:VisualElement class="icon icon--hourglass details-line-icon" />
                            <ui:Label text="Duration" class="details-line-label" />
                            <ui:Label name="recipe-duration" class="details-line-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="details-line">
                            <ui:VisualElement class="icon icon--fire details-line-icon" />
                            <ui:Label text="Calories" class="details-line-label" />
                            <ui:Label name="recipe-calories" class="details-line-value" />
                        </ui:VisualElement>
                    </ui:ScrollView>

                    <!-- How far the item under way has gone, how many to make, and Add to the queue. -->
                    <ui:VisualElement class="recipe-actions">
                        <ui:Label name="recipe-reason" class="recipe-reason" />
                        <ui:VisualElement name="recipe-progress" class="recipe-progress">
                            <ui:VisualElement class="recipe-progress-bar">
                                <ui:VisualElement name="recipe-progress-fill" class="recipe-progress-fill" />
                            </ui:VisualElement>
                            <ui:Label name="recipe-progress-text" class="recipe-progress-text" />
                        </ui:VisualElement>
                        <ui:VisualElement name="recipe-quantity" />
                        <ui:VisualElement class="recipe-buttons">
                            <ui:Button name="recipe-craft" class="button button--primary recipe-button">
                                <ui:Label text="Add to the queue" class="button-text" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The item being dragged, following the pointer. -->
        <ui:VisualElement name="drag-ghost" class="drag-ghost hidden" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
