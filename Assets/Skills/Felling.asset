  - name: Debarking and fine beams
    description: Wood holds no more secrets for you. You know not only how to fell cleanly, but also how to prepare trunks by stripping their bark to get rough beams ready for use.
    xpQuota: 500
    upgrades:
    - id: autoSteps
      name: Automatic work
      icon: {fileID: 2800000, guid: e9a260c684b0e9d45a590e65c439747a, type: 3}
      tags:
      - felling
      description: Two of three steps of felling done for you, as you choose.
      technicalDescription: Interactions felling.autoBuck, felling.autoPrune, felling.autoStump.
      cost: 2
      steps: []
      choices:
      - id: autoBuck
        name: Automatic bucking
        icon: {fileID: 2800000, guid: e9a260c684b0e9d45a590e65c439747a, type: 3}
        description: 'Once a tree you work has no branches left, its trunk falls apart into logs at once: no bucking needed.'
        bonuses:
        - kind: 7
          context: felling.autoBuck
          value: 0
          formula: 
      - id: autoPrune
        name: Automatic pruning
        icon: {fileID: 2800000, guid: 0f2e6c1599776c54d8f248c2020d2c17, type: 3}
        description: A tree you fell comes down with its branches already off.
        bonuses:
        - kind: 7
          context: felling.autoPrune
          value: 0
          formula: 
      - id: autoStump
        name: Automatic stump removal
        icon: {fileID: 2800000, guid: b57519368aecc0a448c67829cf5d9208, type: 3}
        description: 'A tree you fell leaves no stump: its log lies at its foot instead, and nothing grows back there.'
        bonuses:
        - kind: 7
          context: felling.autoStump
          value: 0
          formula: 
      maxChoices: 2
      requires: []
      replaces: 
      hidden: 0
