  m_Name: Felling
  m_EditorClassIdentifier: Voxel.Client::Voxel.Client.SkillAsset
  id: felling
  displayName: Felling
  description: Felling trees, pruning their branches and bucking their trunks into logs, with an axe. Every calorie spent on it teaches you.
  icon: {fileID: 2800000, guid: e70e4cfbb2813e84a917d19b160561b9, type: 3}
  prerequisites: []
  unlocks:
  - context: fell
    tool: 3
  xpContexts:
  - fell
  pointsPerTier: 8
  tiers:
  - name: Firewood, softwood and splitting
    description: 'You hit hard, sometimes crooked, but it comes down. You know how to split softwood logs to light a fire: that''s something.'
    xpQuota: 100
    upgrades:
    - id: calories
      name: Calorie cost
      icon: {fileID: 2800000, guid: cc1005199cdb0014ebeb7bf0d47385dc, type: 3}
      tags:
      - felling
      description: 'Each axe hit on a tree burns fewer calories: 5 % fewer a step. You learn as much.'
      technicalDescription: "CaloriePercent on fell: calories \xD7 (1 - %); experience counts them before."
